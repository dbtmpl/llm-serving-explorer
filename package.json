{
  "name": "llm-serving-explorer",
  "version": "0.1.0",
  "description": "Interactive visual explainer for LLM inference serving: routing, continuous batching, KV cache, memory tiers, P/D disaggregation and autoscaling.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:conformance": "vitest run conformance",
    "conformance:reference": "tsx conformance/scripts/reference.ts",
    "conformance:report": "tsx conformance/scripts/report.ts",
    "conformance:calibrate": "tsx conformance/scripts/calibrate.ts",
    "conformance:summary": "tsx conformance/scripts/summary.ts",
    "docs:sync": "UPDATE_DOCS=1 vitest run src/sim/__tests__/registry.test.ts conformance/__tests__/docs.test.ts"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.9",
    "yaml": "^2.9.1"
  }
}
