+func TestEngineDriver_EventSink_RejectTimeoutPreemptEvictKVAndTier(t *testing.T) {
+	fifo, err := enginetest.NewFIFO(enginetest.FIFOConfig{
+		MaxRunning:     4,
+		TokenBudget:    64,
+		StepBaseUs:     100,
+		StepPerTokenUs: 0,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	eng := &mockRichEngine{
+		FIFO:          fifo,
+		rejectID:      "r-reject",
+		finishErrID:   "r-finerr",
+		preemptOnStep: 2,
+		cachedHitByID: map[string]int{"r-hit": 16},
+		offloadByID:   map[string]int{"r-hit": 8},
+		emitKVByStep: map[int][]engine.KVEvent{
+			1: {
+				{Removed: false, Hash: "h0", Tokens: []int32{1, 2, 3, 4, 5, 6, 7, 8}},
+				{Removed: false, Hash: "h1", Parent: "h0", Tokens: []int32{9, 10, 11, 12, 13, 14, 15, 16}},
+			},
+			3: {
+				{Removed: true, Hash: "h1"},
+			},
+		},
+		tierStartOnStep: 1,
+		tierDone:        map[engine.TransferID]int64{},
+	}
+
+	var buf bytes.Buffer
+	sink := NewJSONLEventSink(&buf)
+	plannedEng := &plannedMockEngine{mockRichEngine: eng}
+
+	d := NewEngineDriver(plannedEng, EngineDriverConfig{
+		Horizon:       1 << 40,
+		Environment:   tierEnv(50),
+		EventSink:     sink,
+		PodID:         "pod-rich",
+		TPDegree:      1,
+		KVBlockSize:   8,
+		KVBlocksTotal: 32,
+		HasCPUOffload: true,
+	})
+	if !eng.kvEventsEnabled {
+		t.Fatal("expected EnableKVEvents() to be called when EventSink is enabled")
+	}
+	if d.kvEventSink != nil {
+		t.Fatal("expected d.kvEventSink to remain nil when SetKVEventSink was not called")
+	}
+
+	// 1. r0 completes normally (2 blocks, 16 tokens).
+	r0 := &Request{ID: "r0", InputTokens: tokens(16), OutputTokens: tokens(2), ArrivalTime: 0}
+	// 2. r-reject refused by Add -> request.rejected (unservable).
+	rReject := &Request{ID: "r-reject", InputTokens: tokens(8), OutputTokens: tokens(1), ArrivalTime: 5}
+	// 3. r-qtimeout expires before queued event runs -> request.timed_out (engine).
+	rQTimeout := &Request{ID: "r-qtimeout", InputTokens: tokens(8), OutputTokens: tokens(1), ArrivalTime: 10, Deadline: 10}
+	// 4. r-rtimeout times out while running -> request.timed_out (engine).
+	rRTimeout := &Request{ID: "r-rtimeout", InputTokens: tokens(8), OutputTokens: tokens(10), ArrivalTime: 20, Deadline: 150}
+	// 5. r-hit arrives later with matching prefix tokens -> shared_with_reqs + cpu_hit_tokens.
+	rHit := &Request{ID: "r-hit", InputTokens: tokens(16), OutputTokens: tokens(1), ArrivalTime: 300}
+	// 6. r-evict evicted in flight -> request.finished (abort).
+	rEvict := &Request{ID: "r-evict", InputTokens: tokens(8), OutputTokens: tokens(5), ArrivalTime: 300}
+	// 7. r-finerr fails with FinishError before emitting -> request.rejected (unservable).
+	rFinErr := &Request{ID: "r-finerr", InputTokens: tokens(8), OutputTokens: tokens(1), ArrivalTime: 300}
+
+	for _, r := range []*Request{r0, rReject, rQTimeout, rRTimeout, rHit, rEvict, rFinErr} {
+		d.InjectArrival(r)
+	}
+
+	for d.HasPendingEvents() {
+		if d.PeekNextEventTime() > 350 && rEvict.State == StateRunning {
+			if !d.Evict(rEvict, 350) {
+				t.Fatal("expected Evict(r-evict) to return true")
+			}
+			continue
+		}
+		d.ProcessNextEvent()
+	}
+	d.Finalize()
+	if err := sink.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	// After h0 and h1 were cached and h1 was evicted, 1 cached block (h0) remains.
+	if got := d.CachedKVBlocksCount(); got != 1 {
+		t.Errorf("CachedKVBlocksCount() = %d, want 1", got)
+	}
+
+	recs := parseNDJSONLines(t, buf.Bytes())
+	seen := map[string]int{}
+	var foundSharedHit, foundCPUOffloadEvict, foundAbortedFinish, foundPreemptFreed bool
+	var movedStatuses []string
+	for _, rec := range recs {
+		typ := rec["type"].(string)
+		seen[typ]++
+		switch typ {
+		case EventTypeKVBlockAllocated:
+			if rec["req_id"] == "r-hit" {
+				if sw, ok := rec["shared_with_reqs"].([]any); ok && len(sw) > 0 {
+					foundSharedHit = true
+				}
+			}
+		case EventTypeRequestScheduled:
+			if rec["req_id"] == "r-hit" && rec["cpu_hit_tokens"] != float64(8) {
+				t.Errorf("r-hit cpu_hit_tokens = %v, want 8", rec["cpu_hit_tokens"])
+			}
+		case EventTypeKVBlockEvicted:
+			if rec["destination"] == "cpu_dram" && rec["reason"] == "lru_eviction" {
+				foundCPUOffloadEvict = true
+			}
+		case EventTypeRequestFinished:
+			if rec["req_id"] == "r-evict" && rec["reason"] == "abort" {
+				foundAbortedFinish = true
+			}
+		case EventTypeRequestPreempted:
+			if fb, ok := rec["freed_blocks"].([]any); ok && len(fb) > 0 {
+				foundPreemptFreed = true
+			}
+		case EventTypeKVBlockMoved:
+			movedStatuses = append(movedStatuses, rec["status"].(string))
+		}
+	}
+
+	if seen[EventTypeRequestRejected] != 2 {
+		t.Errorf("request.rejected count = %d, want 2 (Add failure + FinishError)", seen[EventTypeRequestRejected])
+	}
+	for _, want := range []string{
+		EventTypeRequestRejected,
+		EventTypeRequestTimedOut,
+		EventTypeRequestPreempted,
+		EventTypeRequestFinished,
+		EventTypeKVBlockCached,
+		EventTypeKVBlockEvicted,
+		EventTypeKVBlockMoved,
+	} {
+		if seen[want] == 0 {
+			t.Errorf("missing expected event type %s (seen=%v)", want, seen)
+		}
+	}
+	if !foundSharedHit {
+		t.Error("expected shared_with_reqs on prefix hit r-hit")
+	}
+	if !foundCPUOffloadEvict {
+		t.Error("expected kv.block.evicted with destination=cpu_dram when HasCPUOffload=true")
+	}
+	if !foundAbortedFinish {
+		t.Error("expected request.finished with reason=abort for evicted request")
+	}
+	if !foundPreemptFreed {
+		t.Error("expected non-empty freed_blocks on request.preempted")
+	}
+	if len(movedStatuses) != 2 || movedStatuses[0] != "started" || movedStatuses[1] != "completed" {
+		t.Errorf("kv.block.moved statuses = %v, want [started completed]", movedStatuses)
+	}
+}
diff --git a/sim/kv_block_tracker.go b/sim/kv_block_tracker.go
new file mode 100644
index 00000000..f0ad743a
--- /dev/null
+++ b/sim/kv_block_tracker.go
@@ -0,0 +1,493 @@
+package sim
+
+import (
+	"container/heap"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/inference-sim/blis-substrate/contracts/engine"
+)
+
+// intMinHeap maintains freed physical KV block IDs in deterministic lowest-index-first order.
+type intMinHeap []int
+
+func (h intMinHeap) Len() int           { return len(h) }
+func (h intMinHeap) Less(i, j int) bool { return h[i] < h[j] }
+func (h intMinHeap) Swap(i, j int)      { h[i], h[j] = h[j], h[i] }
+func (h *intMinHeap) Push(x any)        { *h = append(*h, x.(int)) }
+func (h *intMinHeap) Pop() any {
+	old := *h
+	n := len(old)
+	v := old[n-1]
+	*h = old[:n-1]
+	return v
+}
+
+// kvBlockTracker deterministically mirrors physical KV block slot indices [0..KVBlocksTotal-1]
+// for an EngineDriver so emitted kv.block.* and request.preempted events carry consistent,
+// non-negative block IDs without affecting simulation behavior (INV-6).
+type kvBlockTracker struct {
+	blockSize   int
+	totalBlocks int
+
+	nextSlot  int
+	freedHeap intMinHeap
+
+	reqBlocks        map[string][]int
+	reqTokenBlocks   map[string][]string // per-request token-chunk keys by block index
+	blockRefCount    map[int]int
+	blockOwners      map[int][]string
+	lastOwnerByBlock map[int]string
+
+	cachedBlocks     map[int]string    // gpu blockID -> hash
+	cachedOrder      []int             // FIFO insertion order of gpu cached blockIDs
+	cachedByHash     map[string]int    // gpu hash -> blockID
+	cachedByTokenKey map[string]int    // token chunk key -> gpu blockID
+	tokenKeyByBlock  map[int]string    // gpu blockID -> token chunk key
+	cpuCachedByHash  map[string]int    // cpu_dram hash -> blockID
+	nextCPUSlot      int
+}
+
+func newKVBlockTracker(blockSize, totalBlocks int) *kvBlockTracker {
+	if blockSize <= 0 {
+		blockSize = 16
+	}
+	return &kvBlockTracker{
+		blockSize:        blockSize,
+		totalBlocks:      max(totalBlocks, 0),
+		reqBlocks:        map[string][]int{},
+		reqTokenBlocks:   map[string][]string{},
+		blockRefCount:    map[int]int{},
+		blockOwners:      map[int][]string{},
+		lastOwnerByBlock: map[int]string{},
+		cachedBlocks:     map[int]string{},
+		cachedByHash:     map[string]int{},
+		cachedByTokenKey: map[string]int{},
+		tokenKeyByBlock:  map[int]string{},
+		cpuCachedByHash:  map[string]int{},
+	}
+}
+
+func (t *kvBlockTracker) syncGeometry(snap engine.State) {
+	if snap.KVBlockSize > 0 && t.blockSize <= 0 {
+		t.blockSize = snap.KVBlockSize
+	}
+	if snap.KVBlocksTotal > 0 && t.totalBlocks == 0 {
+		t.totalBlocks = int(snap.KVBlocksTotal)
+	}
+}
+
+func (t *kvBlockTracker) allocSlot() int {
+	if len(t.freedHeap) > 0 {
+		return heap.Pop(&t.freedHeap).(int)
+	}
+	if t.totalBlocks == 0 || t.nextSlot < t.totalBlocks {
+		bid := t.nextSlot
+		t.nextSlot++
+		return bid
+	}
+	// Reclaim the oldest unreferenced prefix-cached block if the pool is at capacity.
+	for i, bid := range t.cachedOrder {
+		if t.blockRefCount[bid] == 0 {
+			t.evictCachedBlockMeta(bid)
+			t.cachedOrder = append(t.cachedOrder[:i], t.cachedOrder[i+1:]...)
+			return bid
+		}
+	}
+	// Fallback if totalBlocks was underestimated by config.
+	bid := t.nextSlot
+	t.nextSlot++
+	return bid
+}
+
+func (t *kvBlockTracker) freeSlot(bid int) {
+	if bid < 0 {
+		return
+	}
+	heap.Push(&t.freedHeap, bid)
+}
+
+func (t *kvBlockTracker) addOwner(bid int, reqID string) {
+	t.blockRefCount[bid]++
+	owners := t.blockOwners[bid]
+	if !slices.Contains(owners, reqID) {
+		t.blockOwners[bid] = append(owners, reqID)
+	}
+	t.lastOwnerByBlock[bid] = reqID
+}
+
+func (t *kvBlockTracker) removeOwner(bid int, reqID string) {
+	if t.blockRefCount[bid] > 0 {
+		t.blockRefCount[bid]--
+	}
+	owners := t.blockOwners[bid]
+	for i, o := range owners {
+		if o == reqID {
+			t.blockOwners[bid] = append(owners[:i], owners[i+1:]...)
+			break
+		}
+	}
+	if len(t.blockOwners[bid]) == 0 {
+		delete(t.blockOwners, bid)
+	}
+}
+
+// onScheduled allocates or pins physical blocks needed for s in the current batch.
+// It returns newly allocated/pinned block IDs (empty if no new blocks were needed) and any
+// shared request IDs for prefix hits.
+func (t *kvBlockTracker) onScheduled(s engine.Scheduled, req *Request, snap engine.State) (allocatedIDs []int, sharedWith []string) {
+	t.syncGeometry(snap)
+
+	held := t.reqBlocks[s.ID]
+	totalAfter := max(s.Computed+s.Tokens, 0)
+	blocksNeeded := (totalAfter + t.blockSize - 1) / t.blockSize
+	if blocksNeeded <= len(held) {
+		return nil, nil
+	}
+
+	sharedSet := map[string]bool{}
+	tokKeys := t.reqTokenBlocks[s.ID]
+
+	// Record token chunk keys for the request's prompt blocks if available.
+	if req != nil && len(tokKeys) == 0 && len(req.InputTokens) >= t.blockSize {
+		numPromptBlocks := len(req.InputTokens) / t.blockSize
+		tokKeys = make([]string, numPromptBlocks)
+		for bi := 0; bi < numPromptBlocks; bi++ {
+			tokKeys[bi] = tokensKey(req.InputTokens[bi*t.blockSize : (bi+1)*t.blockSize])
+		}
+		t.reqTokenBlocks[s.ID] = tokKeys
+	}
+
+	// First admission with prefix-cache hit: reuse matching cached blocks when available.
+	if len(held) == 0 && s.CachedTokens > 0 {
+		hitBlocks := min(s.CachedTokens/t.blockSize, blocksNeeded)
+		for bi := 0; bi < hitBlocks; bi++ {
+			var bid int
+			var matched bool
+			if bi < len(tokKeys) && tokKeys[bi] != "" {
+				if existing, ok := t.cachedByTokenKey[tokKeys[bi]]; ok {
+					bid = existing
+					matched = true
+				}
+			}
+			if !matched {
+				bid = t.allocSlot()
+			}
+			for _, owner := range t.blockOwners[bid] {
+				if owner != s.ID {
+					sharedSet[owner] = true
+				}
+			}
+			if prev, ok := t.lastOwnerByBlock[bid]; ok && prev != "" && prev != s.ID {
+				sharedSet[prev] = true
+			}
+			t.addOwner(bid, s.ID)
+			held = append(held, bid)
+			allocatedIDs = append(allocatedIDs, bid)
+		}
+	}
+
+	for len(held) < blocksNeeded {
+		bid := t.allocSlot()
+		t.addOwner(bid, s.ID)
+		held = append(held, bid)
+		allocatedIDs = append(allocatedIDs, bid)
+	}
+
+	t.reqBlocks[s.ID] = held
+	if len(sharedSet) > 0 {
+		sharedWith = make([]string, 0, len(sharedSet))
+		for id := range sharedSet {
+			sharedWith = append(sharedWith, id)
+		}
+		sort.Strings(sharedWith)
+	}
+	return allocatedIDs, sharedWith
+}
+
+// onPreempted releases all blocks held by a preempted request and returns the freed block IDs.
+func (t *kvBlockTracker) onPreempted(reqID string) []int {
+	blocks := t.reqBlocks[reqID]
+	delete(t.reqBlocks, reqID)
+	delete(t.reqTokenBlocks, reqID)
+	freed := make([]int, 0, len(blocks))
+	for _, bid := range blocks {
+		t.removeOwner(bid, reqID)
+		if t.blockRefCount[bid] == 0 {
+			freed = append(freed, bid)
+			if _, isCached := t.cachedBlocks[bid]; !isCached {
+				t.freeSlot(bid)
+			}
+		}
+	}
+	return freed
+}
+
+// onFinished releases blocks held by reqID unless retainKV is true (disaggregated prefill hold).
+func (t *kvBlockTracker) onFinished(reqID string, retainKV bool) {
+	if retainKV {
+		return
+	}
+	blocks := t.reqBlocks[reqID]
+	delete(t.reqBlocks, reqID)
+	delete(t.reqTokenBlocks, reqID)
+	for _, bid := range blocks {
+		t.removeOwner(bid, reqID)
+		if t.blockRefCount[bid] == 0 {
+			if _, isCached := t.cachedBlocks[bid]; !isCached {
+				t.freeSlot(bid)
+			}
+		}
+	}
+}
+
+// blockIDsForReq returns up to limit block IDs currently held by reqID (or deterministic fallback).
+func (t *kvBlockTracker) blockIDsForReq(reqID string, limit int) []int {
+	if limit <= 0 {
+		return []int{}
+	}
+	held := t.reqBlocks[reqID]
+	if len(held) >= limit {
+		out := make([]int, limit)
+		copy(out, held[:limit])
+		return out
+	}
+	out := make([]int, 0, limit)
+	out = append(out, held...)
+	for i := len(out); i < limit; i++ {
+		out = append(out, i)
+	}
+	return out
+}
+
+// onKVEvents translates engine KVEvent entries into KVBlockCachedEvent / KVBlockEvictedEvent records.
+func (t *kvBlockTracker) onKVEvents(events []engine.KVEvent, podID string, gpuIndices []int, hasCPUOffload bool) []EventRecord {
+	if len(events) == 0 {
+		return nil
+	}
+	var out []EventRecord
+	var curCached *KVBlockCachedEvent
+	var curEvicted *KVBlockEvictedEvent
+
+	flushCached := func() {
+		if curCached != nil {
+			out = append(out, curCached)
+			curCached = nil
+		}
+	}
+	flushEvicted := func() {
+		if curEvicted != nil {
+			out = append(out, curEvicted)
+			curEvicted = nil
+		}
+	}
+
+	for _, ev := range events {
+		tier := "gpu"
+		if ev.Tier == "cpu" {
+			tier = "cpu_dram"
+		}
+
+		if !ev.Removed {
+			flushEvicted()
+			var bid int
+			var prevOwner string
+			if tier == "cpu_dram" {
+				if existing, ok := t.cpuCachedByHash[ev.Hash]; ok {
+					bid = existing
+				} else if gpuBid, ok := t.cachedByHash[ev.Hash]; ok {
+					bid = gpuBid
+					t.cpuCachedByHash[ev.Hash] = bid
+				} else {
+					bid = t.nextCPUSlot
+					t.nextCPUSlot++
+					t.cpuCachedByHash[ev.Hash] = bid
+				}
+			} else {
+				bid, prevOwner = t.recordGPUCachedBlock(ev)
+			}
+
+			if curCached != nil && curCached.Tier == tier && curCached.PrevOwnerReqID == prevOwner {
+				curCached.BlockIDs = append(curCached.BlockIDs, bid)
+				curCached.BlockHashes = append(curCached.BlockHashes, ev.Hash)
+				continue
+			}
+			flushCached()
+			curCached = &KVBlockCachedEvent{
+				PodID:          podID,
+				GPUIndices:     slices.Clone(gpuIndices),
+				BlockIDs:       []int{bid},
+				BlockHashes:    []string{ev.Hash},
+				PrevOwnerReqID: prevOwner,
+				Tier:           tier,
+			}
+			continue
+		}
+
+		// ev.Removed == true -> kv.block.evicted
+		flushCached()
+		var bid int
+		if tier == "cpu_dram" {
+			if existing, ok := t.cpuCachedByHash[ev.Hash]; ok {
+				bid = existing
+				delete(t.cpuCachedByHash, ev.Hash)
+			}
+		} else {
+			if existing, ok := t.cachedByHash[ev.Hash]; ok {
+				bid = existing
+				delete(t.cachedByHash, ev.Hash)
+				if curHash, ok := t.cachedBlocks[bid]; ok && curHash == ev.Hash {
+					t.evictCachedBlockMeta(bid)
+					t.removeFromCachedOrder(bid)
+					if t.blockRefCount[bid] == 0 {
+						t.freeSlot(bid)
+					}
+				}
+			}
+		}
+
+		dest := "dropped"
+		if tier == "gpu" && hasCPUOffload {
+			dest = "cpu_dram"
+		}
+		if curEvicted != nil && curEvicted.Tier == tier && curEvicted.Destination == dest {
+			curEvicted.BlockIDs = append(curEvicted.BlockIDs, bid)
+			curEvicted.BlockHashes = append(curEvicted.BlockHashes, ev.Hash)
+			continue
+		}
+		flushEvicted()
+		curEvicted = &KVBlockEvictedEvent{
+			PodID:       podID,
+			GPUIndices:  slices.Clone(gpuIndices),
+			BlockIDs:    []int{bid},
+			BlockHashes: []string{ev.Hash},
+			Tier:        tier,
+			Destination: dest,
+			Reason:      "lru_eviction",
+		}
+	}
+
+	flushCached()
+	flushEvicted()
+	return out
+}
+
+func (t *kvBlockTracker) recordGPUCachedBlock(ev engine.KVEvent) (bid int, prevOwner string) {
+	if existing, ok := t.cachedByHash[ev.Hash]; ok {
+		return existing, t.lastOwnerByBlock[existing]
+	}
+
+	tokKey := tokensKey32(ev.Tokens)
+	if tokKey != "" {
+		if existing, ok := t.cachedByTokenKey[tokKey]; ok {
+			bid = existing
+			prevOwner = t.lastOwnerByBlock[bid]
+		} else {
+			// Deterministically match an active request's block at this token chunk.
+			reqIDs := make([]string, 0, len(t.reqTokenBlocks))
+			for id := range t.reqTokenBlocks {
+				reqIDs = append(reqIDs, id)
+			}
+			sort.Strings(reqIDs)
+			found := false
+			for _, id := range reqIDs {
+				keys := t.reqTokenBlocks[id]
+				blocks := t.reqBlocks[id]
+				for bi, k := range keys {
+					if k == tokKey && bi < len(blocks) {
+						bid = blocks[bi]
+						prevOwner = id
+						found = true
+						break
+					}
+				}
+				if found {
+					break
+				}
+			}
+			if !found {
+				bid = t.allocSlot()
+			}
+			t.cachedByTokenKey[tokKey] = bid
+			t.tokenKeyByBlock[bid] = tokKey
+		}
+	} else {
+		bid = t.allocSlot()
+	}
+
+	if _, already := t.cachedBlocks[bid]; !already {
+		t.cachedOrder = append(t.cachedOrder, bid)
+	}
+	t.cachedBlocks[bid] = ev.Hash
+	t.cachedByHash[ev.Hash] = bid
+	if prevOwner != "" {
+		t.lastOwnerByBlock[bid] = prevOwner
+	} else {
+		prevOwner = t.lastOwnerByBlock[bid]
+	}
+	return bid, prevOwner
+}
+
+func (t *kvBlockTracker) evictCachedBlockMeta(bid int) {
+	if h, ok := t.cachedBlocks[bid]; ok {
+		delete(t.cachedBlocks, bid)
+		if t.cachedByHash[h] == bid {
+			delete(t.cachedByHash, h)
+		}
+	}
+	if tk, ok := t.tokenKeyByBlock[bid]; ok {
+		delete(t.tokenKeyByBlock, bid)
+		if t.cachedByTokenKey[tk] == bid {
+			delete(t.cachedByTokenKey, tk)
+		}
+	}
+}
+
+func (t *kvBlockTracker) removeFromCachedOrder(bid int) {
+	for i, id := range t.cachedOrder {
+		if id == bid {
+			t.cachedOrder = append(t.cachedOrder[:i], t.cachedOrder[i+1:]...)
+			return
+		}
+	}
+}
+
+// cachedCount returns the number of GPU prefix-cache blocks currently resident in the tracker.
+func (t *kvBlockTracker) cachedCount() int {
+	if t == nil {
+		return 0
+	}
+	return len(t.cachedBlocks)
+}
+
+func tokensKey(ts []TokenID) string {
+	if len(ts) == 0 {
+		return ""
+	}
+	var sb strings.Builder
+	sb.Grow(len(ts) * 4)
+	for i, v := range ts {
+		if i > 0 {
+			sb.WriteByte(',')
+		}
+		sb.WriteString(strconv.FormatInt(int64(v), 10))
+	}
+	return sb.String()
+}
+
+func tokensKey32(ts []int32) string {
+	if len(ts) == 0 {
+		return ""
+	}
+	var sb strings.Builder
+	sb.Grow(len(ts) * 4)
+	for i, v := range ts {
+		if i > 0 {
+			sb.WriteByte(',')
+		}
+		sb.WriteString(strconv.FormatInt(int64(v), 10))
+	}
+	return sb.String()
+}
diff --git a/sim/roofline.go b/sim/roofline.go
new file mode 100644
index 00000000..d2ccefb7
--- /dev/null
+++ b/sim/roofline.go
@@ -0,0 +1,158 @@
+package sim
+
+import (
+	"math"
+
+	"github.com/inference-sim/blis-substrate/contracts/engine"
+)
+
+// ModelRooflineSpec holds pure-primitive model architecture, parallelism, and GPU roofline
+// parameters used to derive analytical RooflinePoint values for each executed batch.
+type ModelRooflineSpec struct {
+	ModelName string
+
+	HiddenSize        int64
+	IntermediateSize  int64
+	NumHiddenLayers   int64
+	NumAttentionHeads int64
+	NumKVHeads        int64
+	HeadDim           int64
+	VocabSize         int64
+
+	IsMoE         bool
+	NumExperts    int64
+	ExpertsPerTok int64
+
+	WeightBytesPerRank   int64
+	ActivationPeakBytes  int64
+	KVBytesPerTokenPerRank int64
+
+	TP int
+	PP int
+
+	ChipTFLOPsPeak    float64
+	ChipTFLOPsFP8     float64
+	ChipBWTBs         float64
+	IsFP8             bool
+	ComputePeakTFLOPs float64
+}
+
+// EstimateBatch computes analytical per-rank FLOPs, HBM bytes moved, arithmetic intensity,
+// achieved TFLOP/s and TB/s, and the roofline bottleneck ("compute" vs "memory_bw") for b.
+func (s *ModelRooflineSpec) EstimateBatch(b engine.Batch, durationUS int64) RooflinePoint {
+	if durationUS < 1 {
+		durationUS = 1
+	}
+	if s == nil {
+		return RooflinePoint{
+			Bottleneck: "memory_bw",
+			Derived:    true,
+		}
+	}
+
+	var totalTokens int64
+	var kvReadTokens int64
+	var kvWriteTokens int64
+	var attnPairs float64
+
+	for _, req := range b.Reqs {
+		toks := int64(max(req.Tokens, 0))
+		if toks == 0 {
+			continue
+		}
+		ctx := int64(max(req.Computed+req.Tokens, 0))
+		totalTokens += toks
+		kvReadTokens += ctx
+		kvWriteTokens += toks
+		attnPairs += float64(toks) * float64(ctx)
+	}
+
+	if totalTokens == 0 {
+		return RooflinePoint{
+			Bottleneck: "memory_bw",
+			Derived:    true,
+		}
+	}
+
+	layers := float64(max(s.NumHiddenLayers, 0))
+	h := float64(max(s.HiddenSize, 0))
+	inter := float64(max(s.IntermediateSize, 0))
+	nQ := float64(max(s.NumAttentionHeads, 0))
+	nKV := float64(max(s.NumKVHeads, 0))
+	if nKV == 0 {
+		nKV = nQ
+	}
+	headDim := float64(max(s.HeadDim, 0))
+	if headDim == 0 && nQ > 0 {
+		headDim = h / nQ
+	}
+	vocab := float64(max(s.VocabSize, 0))
+
+	activeExperts := 1.0
+	if s.IsMoE {
+		activeExperts = float64(max(s.ExpertsPerTok, 1))
+	}
+
+	// Linear projections per token:
+	// - Attention Q, K, V, O projections: 2*H*(nQ*d) + 2*H*(nKV*d) + 2*(nQ*d)*H = 4*H*d*(nQ + nKV)
+	// - SwiGLU / gated MLP projections (gate, up, down): 6*H*I * activeExperts
+	// - LM head: 2*H*V
+	attnLinearPerToken := 4.0 * h * headDim * (nQ + nKV)
+	mlpLinearPerToken := 6.0 * h * inter * activeExperts
+	lmHeadPerToken := 2.0 * h * vocab
+	linearFlops := float64(totalTokens)*(layers*(attnLinearPerToken+mlpLinearPerToken)+lmHeadPerToken)
+
+	// Attention QK^T and AV FLOPs across all layers and query heads: 4 * L * nQ * d * sum(tokens * ctx).
+	attnFlops := 4.0 * layers * nQ * headDim * attnPairs
+
+	ranks := float64(max(s.TP, 1) * max(s.PP, 1))
+	flopsPerRank := (linearFlops + attnFlops) / ranks
+
+	// Analytical HBM bytes moved per rank:
+	// weights read once per batch + KV cache read for active contexts + KV written for scheduled tokens.
+	weightsRead := float64(max(s.WeightBytesPerRank, 0))
+	kvPerTok := float64(max(s.KVBytesPerTokenPerRank, 0))
+	bytesMoved := weightsRead + float64(kvReadTokens+kvWriteTokens)*kvPerTok
+
+	durS := float64(durationUS) / 1e6
+	var ai float64
+	if bytesMoved > 0 {
+		ai = flopsPerRank / bytesMoved
+	}
+	achievedTFLOPs := flopsPerRank / durS / 1e12
+	achievedBWTBs := bytesMoved / durS / 1e12
+
+	computePeak := s.ComputePeakTFLOPs
+	if computePeak <= 0 {
+		if s.IsFP8 && s.ChipTFLOPsFP8 > 0 {
+			computePeak = s.ChipTFLOPsFP8
+		} else {
+			computePeak = s.ChipTFLOPsPeak
+		}
+	}
+
+	bottleneck := "memory_bw"
+	if computePeak > 0 && s.ChipBWTBs > 0 {
+		ridge := (computePeak * 1e12) / (s.ChipBWTBs * 1e12)
+		if ai >= ridge {
+			bottleneck = "compute"
+		}
+	}
+
+	return RooflinePoint{
+		FLOPs:               sanitizeNonNeg(flopsPerRank),
+		BytesMoved:          sanitizeNonNeg(bytesMoved),
+		ArithmeticIntensity: sanitizeNonNeg(ai),
+		AchievedTFLOPs:      sanitizeNonNeg(achievedTFLOPs),
+		AchievedBWTBs:       sanitizeNonNeg(achievedBWTBs),
+		Bottleneck:          bottleneck,
+		Derived:             true,
+	}
+}
+
+func sanitizeNonNeg(v float64) float64 {
+	if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 {
+		return 0
+	}
+	return v
+}
