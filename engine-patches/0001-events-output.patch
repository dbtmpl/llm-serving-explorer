+// mockRichEngine wraps enginetest.FIFO to exercise KVEvents, OffloadCachedTokens, prefix hits,
+// preemptions, Add rejections, FinishError, and tier transfers.
+type mockRichEngine struct {
+	*enginetest.FIFO
+	kvEventsEnabled bool
+	rejectID        string
+	finishErrID     string
+	preemptOnStep   int
+	stepCount       int
+	cachedHitByID   map[string]int
+	offloadByID     map[string]int
+	emitKVByStep    map[int][]engine.KVEvent
+	tierStartOnStep int
+	tierDone        map[engine.TransferID]int64
+}
+
+func (m *mockRichEngine) EnableKVEvents() { m.kvEventsEnabled = true }
+
+func (m *mockRichEngine) OffloadCachedTokens(id string) int {
+	return m.offloadByID[id]
+}
+
+func (m *mockRichEngine) Add(r engine.Request, now engine.Time) error {
+	if r.ID == m.rejectID {
+		return errors.New("prompt exceeds max_model_len")
+	}
+	return m.FIFO.Add(r, now)
+}
+
+func (m *mockRichEngine) Schedule(now engine.Time) (engine.Batch, error) {
+	b, err := m.FIFO.Schedule(now)
+	if err != nil {
+		return b, err
+	}
+	if !b.Empty() {
+		m.stepCount++
+		for i := range b.Reqs {
+			if hit := m.cachedHitByID[b.Reqs[i].ID]; hit > 0 && b.Reqs[i].Computed == 0 {
+				b.Reqs[i].PrefixLookup = true
+				b.Reqs[i].CachedTokens = hit
+			}
+		}
+		if m.stepCount == m.preemptOnStep && len(b.Reqs) > 0 {
+			b.Preempted = append(b.Preempted, b.Reqs[0].ID)
+		}
+		if m.stepCount == m.tierStartOnStep && len(b.Reqs) > 0 {
+			b.TransfersStarted = append(b.TransfersStarted, tierTransfer(2001, b.Reqs[0].ID, engine.TransferStore))
+		}
+	}
+	return b, nil
+}
+
+func (m *mockRichEngine) Complete(id engine.BatchID, out engine.Outcome, end engine.Time) (engine.Result, error) {
+	res, err := m.FIFO.Complete(id, out, end)
+	if err != nil {
+		return res, err
+	}
+	if m.kvEventsEnabled {
+		if evs := m.emitKVByStep[m.stepCount]; len(evs) > 0 {
+			res.KVEvents = evs
+		}
+	}
+	if m.finishErrID != "" {
+		for i, f := range res.Finished {
+			if f.ID == m.finishErrID {
+				res.Finished[i].Reason = engine.FinishError
+				res.Finished[i].OutputTokens = 0
+				delete(res.Emitted, m.finishErrID)
+			}
+		}
+	}
+	return res, nil
+}
+
+func (m *mockRichEngine) TransferDone(id engine.TransferID, ok bool, now engine.Time) error {
+	if id >= 2000 {
+		m.tierDone[id] = now
+		return nil
+	}
+	return m.FIFO.TransferDone(id, ok, now)
+}
