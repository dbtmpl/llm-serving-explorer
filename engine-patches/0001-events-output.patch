diff --git a/sim/engine_driver_events.go b/sim/engine_driver_events.go
new file mode 100644
index 00000000..62b4cc5f
--- /dev/null
+++ b/sim/engine_driver_events.go
@@ -0,0 +1,270 @@
+package sim
+
+import (
+	"github.com/sirupsen/logrus"
+
+	"github.com/inference-sim/blis-substrate/contracts/engine"
+)
+
+type pendingSinkEvent struct {
+	tUS int64
+	ev  EventRecord
+}
+
+type tierTransferInfo struct {
+	reqID      string
+	fromTier   string
+	toTier     string
+	direction  string
+	blockIDs   []int
+	numBlocks  int
+	tokens     int
+	durationUS int64
+}
+
+func (d *EngineDriver) sinkEnabled() bool {
+	return d.cfg.EventSink != nil && d.cfg.EventSink.Enabled()
+}
+
+func (d *EngineDriver) podID() string {
+	if d.cfg.PodID != "" {
+		return d.cfg.PodID
+	}
+	return "pod-0"
+}
+
+func (d *EngineDriver) gpuIndices() []int {
+	n := d.cfg.TPDegree
+	if n <= 0 {
+		n = d.cfg.GPUsPerPod
+	}
+	if n <= 0 {
+		n = 1
+	}
+	out := make([]int, n)
+	for i := range out {
+		out[i] = i
+	}
+	return out
+}
+
+func (d *EngineDriver) emitEvent(tUS int64, ev EventRecord) {
+	if !d.sinkEnabled() || ev == nil {
+		return
+	}
+	if err := d.cfg.EventSink.Emit(tUS, ev); err != nil {
+		logrus.Warnf("event sink emit failed: %v", err)
+	}
+}
+
+func (d *EngineDriver) flushPendingEndEvents(upTo int64) {
+	if len(d.pendingEndEvents) == 0 {
+		return
+	}
+	remaining := d.pendingEndEvents[:0]
+	for _, pe := range d.pendingEndEvents {
+		if pe.tUS <= upTo {
+			d.emitEvent(pe.tUS, pe.ev)
+		} else {
+			remaining = append(remaining, pe)
+		}
+	}
+	if len(remaining) == 0 {
+		d.pendingEndEvents = nil
+		return
+	}
+	d.pendingEndEvents = remaining
+}
+
+// FlushSinkEvents emits any deferred step-end events with timestamps <= upTo.
+func (d *EngineDriver) FlushSinkEvents(upTo int64) {
+	d.flushPendingEndEvents(upTo)
+}
+
+// CachedKVBlocksCount returns the number of GPU prefix-cache blocks currently resident in
+// the driver's KV block tracker (read-only observability signal).
+func (d *EngineDriver) CachedKVBlocksCount() int {
+	return d.kvTracker.cachedCount()
+}
+
+func (d *EngineDriver) emitStepEvents(b engine.Batch, start, end int64, res engine.Result, firstEmitted map[string]bool) []EventRecord {
+	if !d.sinkEnabled() {
+		return nil
+	}
+	var out []EventRecord
+	podID := d.podID()
+	durationUS := max(end-start, 1)
+
+	if len(b.Reqs) > 0 {
+		members := make([]BatchMember, 0, len(b.Reqs))
+		prefillTokens, decodeTokens := 0, 0
+		for _, s := range b.Reqs {
+			role := "decode"
+			if s.Computed < s.PromptLen {
+				role = "prefill"
+				prefillTokens += s.Tokens
+			} else {
+				decodeTokens += s.Tokens
+			}
+			members = append(members, BatchMember{
+				ReqID:          s.ID,
+				Role:           role,
+				Tokens:         max(s.Tokens, 1),
+				ComputedBefore: max(s.Computed, 0),
+			})
+		}
+		phase := "decode"
+		if prefillTokens > 0 && decodeTokens > 0 {
+			phase = "mixed"
+		} else if prefillTokens > 0 {
+			phase = "prefill"
+		}
+		roofline := RooflinePoint{
+			Bottleneck: "memory_bw",
+			Derived:    true,
+		}
+		if d.cfg.RooflineSpec != nil {
+			roofline = d.cfg.RooflineSpec.EstimateBatch(b, durationUS)
+		}
+		out = append(out, &BatchStepEvent{
+			PodID:         podID,
+			BatchID:       uint64(b.ID),
+			Phase:         phase,
+			Members:       members,
+			PrefillTokens: prefillTokens,
+			DecodeTokens:  decodeTokens,
+			TotalTokens:   prefillTokens + decodeTokens,
+			DurationUS:    durationUS,
+			Roofline:      roofline,
+		})
+
+		for _, s := range b.Reqs {
+			emittedNow := res.Emitted[s.ID]
+			totalEmitted := emittedNow
+			if r := d.reqs[s.ID]; r != nil {
+				totalEmitted = r.emitted
+				r.lastComputed = s.Computed + s.Tokens
+			}
+			isFirst := firstEmitted[s.ID]
+			if s.Computed < s.PromptLen {
+				out = append(out, &RequestPrefillEvent{
+					ReqID:           s.ID,
+					PodID:           podID,
+					BatchID:         uint64(b.ID),
+					TokensProcessed: max(s.Tokens, 0),
+					ComputedAfter:   max(s.Computed+s.Tokens, 0),
+					PromptTokens:    max(s.PromptLen, 0),
+					DurationUS:      durationUS,
+				})
+				if emittedNow > 0 || isFirst {
+					out = append(out, &RequestDecodeStepEvent{
+						ReqID:         s.ID,
+						PodID:         podID,
+						BatchID:       uint64(b.ID),
+						TokensEmitted: max(emittedNow, 0),
+						TotalEmitted:  max(totalEmitted, 0),
+						IsFirstToken:  isFirst,
+						DurationUS:    durationUS,
+					})
+				}
+			} else {
+				out = append(out, &RequestDecodeStepEvent{
+					ReqID:         s.ID,
+					PodID:         podID,
+					BatchID:       uint64(b.ID),
+					TokensEmitted: max(emittedNow, 0),
+					TotalEmitted:  max(totalEmitted, 0),
+					IsFirstToken:  isFirst,
+					DurationUS:    durationUS,
+				})
+			}
+		}
+	}
+
+	if d.kvTracker != nil && len(res.KVEvents) > 0 {
+		out = append(out, d.kvTracker.onKVEvents(res.KVEvents, podID, d.gpuIndices(), d.cfg.HasCPUOffload)...)
+	}
+	return out
+}
+
+func (d *EngineDriver) emitTierTransferStarted(t engine.Transfer, now, durationUS int64) {
+	if !d.sinkEnabled() {
+		return
+	}
+	fromTier, toTier, direction := "gpu", "cpu_dram", "offload"
+	if t.Kind == engine.TransferLoad {
+		fromTier, toTier, direction = "cpu_dram", "gpu", "load"
+	}
+	var blockIDs []int
+	if d.kvTracker != nil {
+		blockIDs = d.kvTracker.blockIDsForReq(t.Request, t.Blocks)
+	} else {
+		blockIDs = []int{}
+	}
+	info := tierTransferInfo{
+		reqID:      t.Request,
+		fromTier:   fromTier,
+		toTier:     toTier,
+		direction:  direction,
+		blockIDs:   blockIDs,
+		numBlocks:  max(t.Blocks, 0),
+		tokens:     max(t.Tokens, 0),
+		durationUS: max(durationUS, 0),
+	}
+	if d.tierTransfers == nil {
+		d.tierTransfers = map[engine.TransferID]tierTransferInfo{}
+	}
+	d.tierTransfers[t.ID] = info
+	d.emitEvent(now, &KVBlockMovedEvent{
+		PodID:      d.podID(),
+		TransferID: uint64(t.ID),
+		ReqID:      info.reqID,
+		FromTier:   info.fromTier,
+		ToTier:     info.toTier,
+		Direction:  info.direction,
+		BlockIDs:   info.blockIDs,
+		NumBlocks:  info.numBlocks,
+		Tokens:     info.tokens,
+		DurationUS: 0,
+		Status:     "started",
+	})
+}
+
+func (d *EngineDriver) emitTierTransferCompleted(id engine.TransferID, at int64) {
+	if !d.sinkEnabled() {
+		return
+	}
+	info, ok := d.tierTransfers[id]
+	if !ok {
+		return
+	}
+	delete(d.tierTransfers, id)
+	d.emitEvent(at, &KVBlockMovedEvent{
+		PodID:      d.podID(),
+		TransferID: uint64(id),
+		ReqID:      info.reqID,
+		FromTier:   info.fromTier,
+		ToTier:     info.toTier,
+		Direction:  info.direction,
+		BlockIDs:   info.blockIDs,
+		NumBlocks:  info.numBlocks,
+		Tokens:     info.tokens,
+		DurationUS: info.durationUS,
+		Status:     "completed",
+	})
+}
+
+func mapFinishReason(r engine.FinishReason) string {
+	switch r {
+	case engine.FinishStop:
+		return "stop"
+	case engine.FinishLength:
+		return "length"
+	case engine.FinishAbort:
+		return "abort"
+	case engine.FinishError:
+		return "error"
+	default:
+		return "stop"
+	}
+}
