+}
+
+func (s *recordingSink) Emit(tUS int64, ev sim.EventRecord) error {
+	if ev == nil {
+		return nil
+	}
+	s.seq++
+	ev.SetHeader(s.seq, tUS, ev.EventType())
+	s.events = append(s.events, recordedEvent{tUS: tUS, ev: ev})
+	return nil
+}
