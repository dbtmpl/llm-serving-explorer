diff --git a/sim/events_sink.go b/sim/events_sink.go
new file mode 100644
index 00000000..270ff30b
--- /dev/null
+++ b/sim/events_sink.go
@@ -0,0 +1,171 @@
+package sim
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"io"
+	"sync"
+)
+
+// EventSink writes structured v1 NDJSON simulation events without influencing simulation state (INV-6).
+type EventSink interface {
+	Enabled() bool
+	WriteHeader(h *HeaderRecord) error
+	Emit(tUS int64, ev EventRecord) error
+	Flush() error
+	Close() error
+}
+
+// JSONLEventSink is a buffered, thread-safe EventSink writing compact NDJSON lines.
+type JSONLEventSink struct {
+	mu            sync.Mutex
+	w             io.Writer
+	bw            *bufio.Writer
+	enc           *json.Encoder
+	seq           uint64
+	lastTUs       int64
+	headerWritten bool
+	closed        bool
+}
+
+// NewJSONLEventSink constructs a JSONLEventSink writing NDJSON records to w.
+// If w implements io.Closer, Close flushes the buffer and closes w.
+func NewJSONLEventSink(w io.Writer) *JSONLEventSink {
+	if w == nil {
+		return nil
+	}
+	bw := bufio.NewWriterSize(w, 64*1024)
+	enc := json.NewEncoder(bw)
+	enc.SetEscapeHTML(false)
+	return &JSONLEventSink{
+		w:   w,
+		bw:  bw,
+		enc: enc,
+	}
+}
+
+// Enabled reports whether the sink is active and ready to receive events.
+func (s *JSONLEventSink) Enabled() bool {
+	return s != nil
+}
+
+// WriteHeader writes the v1 HeaderRecord as the first NDJSON line without advancing event seq.
+func (s *JSONLEventSink) WriteHeader(h *HeaderRecord) error {
+	if s == nil {
+		return nil
+	}
+	if h == nil {
+		return errors.New("event sink: nil header record")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return errors.New("event sink: closed")
+	}
+	if s.headerWritten {
+		return errors.New("event sink: header already written")
+	}
+
+	rec := *h
+	rec.Type = EventTypeHeader
+	rec.SchemaVersion = SchemaVersionV1
+	if rec.BLIS.StackVersions == nil {
+		rec.BLIS.StackVersions = map[string]string{}
+	}
+	if rec.Scenario.Flags == nil {
+		rec.Scenario.Flags = map[string]any{}
+	}
+	if rec.Topology.Tiers.UnmodelledNotes == nil {
+		rec.Topology.Tiers.UnmodelledNotes = map[string]string{}
+	}
+	if rec.Topology.InitialPods == nil {
+		rec.Topology.InitialPods = []InitialPod{}
+	}
+	if rec.Topology.Pools == nil {
+		rec.Topology.Pools = []PoolConfig{}
+	}
+
+	if err := s.enc.Encode(&rec); err != nil {
+		return err
+	}
+	s.headerWritten = true
+	return nil
+}
+
+// Emit stamps seq and monotonically non-decreasing t_us on ev and writes it as one JSON line.
+func (s *JSONLEventSink) Emit(tUS int64, ev EventRecord) error {
+	if s == nil || ev == nil {
+		return nil
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return errors.New("event sink: closed")
+	}
+	if tUS < 0 {
+		tUS = 0
+	}
+	if tUS < s.lastTUs {
+		tUS = s.lastTUs
+	}
+	s.lastTUs = tUS
+
+	seq := s.seq
+	s.seq++
+	ev.SetHeader(seq, tUS, ev.EventType())
+	return s.enc.Encode(ev)
+}
+
+// Flush flushes any buffered NDJSON lines to the underlying writer.
+func (s *JSONLEventSink) Flush() error {
+	if s == nil {
+		return nil
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return nil
+	}
+	return s.bw.Flush()
+}
+
+// Close flushes buffered records and closes the underlying writer if it implements io.Closer.
+func (s *JSONLEventSink) Close() error {
+	if s == nil {
+		return nil
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return nil
+	}
+	s.closed = true
+	flushErr := s.bw.Flush()
+	if c, ok := s.w.(io.Closer); ok {
+		if closeErr := c.Close(); closeErr != nil && flushErr == nil {
+			return closeErr
+		}
+	}
+	return flushErr
+}
+
+// Seq returns the next sequence number to be assigned (total emitted events so far).
+func (s *JSONLEventSink) Seq() uint64 {
+	if s == nil {
+		return 0
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.seq
+}
+
+// LastTUs returns the latest emitted event timestamp in microseconds.
+func (s *JSONLEventSink) LastTUs() int64 {
+	if s == nil {
+		return 0
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.lastTUs
+}
diff --git a/sim/events_test.go b/sim/events_test.go
new file mode 100644
index 00000000..cd15c1a5
--- /dev/null
+++ b/sim/events_test.go
@@ -0,0 +1,680 @@
+package sim
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"math"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/inference-sim/blis-substrate/contracts/conformance/enginetest"
+	"github.com/inference-sim/blis-substrate/contracts/engine"
+	"github.com/inference-sim/blis-substrate/contracts/engine/plan"
+)
+
+func parseNDJSONLines(t *testing.T, data []byte) []map[string]any {
+	t.Helper()
+	lines := strings.Split(strings.TrimSpace(string(data)), "\n")
+	out := make([]map[string]any, 0, len(lines))
+	for i, line := range lines {
+		if strings.TrimSpace(line) == "" {
+			continue
+		}
+		var m map[string]any
+		if err := json.Unmarshal([]byte(line), &m); err != nil {
+			t.Fatalf("line %d invalid JSON: %v\nline=%s", i, err, line)
+		}
+		out = append(out, m)
+	}
+	return out
+}
+
+func TestJSONLEventSink_HeaderAndMonotonicSeqAndTUs(t *testing.T) {
+	var nilSink *JSONLEventSink
+	if nilSink.Enabled() {
+		t.Fatal("nil *JSONLEventSink should report Enabled() == false")
+	}
+	if err := nilSink.Emit(10, &RequestQueuedEvent{ReqID: "r0", PodID: "p0", QueueDepth: 1}); err != nil {
+		t.Fatalf("nil sink Emit should be a no-op, got %v", err)
+	}
+
+	var buf bytes.Buffer
+	sink := NewJSONLEventSink(&buf)
+	if !sink.Enabled() {
+		t.Fatal("non-nil sink should report Enabled() == true")
+	}
+
+	hdr := &HeaderRecord{
+		BLIS: HeaderBLIS{
+			Commit:      "abcdef1",
+			VLLMVersion: "0.32.0",
+			LLMDVersion: "1.0.0",
+		},
+		Scenario: HeaderScenario{
+			Name:      "test-run",
+			Model:     "llama-3",
+			Hardware:  "H100",
+			Seed:      42,
+			HorizonUS: 100000,
+		},
+		Topology: HeaderTopology{
+			GatewayLatencyUS: 100,
+			Pools: []PoolConfig{{
+				Role:                "colocated",
+				Replicas:            1,
+				TP:                  1,
+				PP:                  1,
+				DP:                  1,
+				GPUsPerPod:          1,
+				GPUType:             "H100",
+				GPUSpecs:            GPUSpecs{MemoryGiB: 80, TFLOPsPeak: 989, TFLOPsFP8: 1979, BWPeakTBs: 3.35, SMCount: 132},
+				KVBlocksPerGPU:      1024,
+				KVBlockSizeTokens:   16,
+				MaxNumSeqs:          256,
+				MaxNumBatchedTokens: 2048,
+				MaxModelLen:         8192,
+			}},
+		},
+	}
+	if err := sink.WriteHeader(hdr); err != nil {
+		t.Fatalf("WriteHeader failed: %v", err)
+	}
+	if err := sink.WriteHeader(hdr); err == nil {
+		t.Fatal("second WriteHeader should fail")
+	}
+
+	// Emit with negative timestamp (clamped to 0), increasing timestamp, then out-of-order timestamp (clamped to 50).
+	if err := sink.Emit(-10, &RequestArrivedEvent{ReqID: "r0", PromptTokens: 16, MaxOutputTokens: 4}); err != nil {
+		t.Fatal(err)
+	}
+	if err := sink.Emit(50, &RequestQueuedEvent{ReqID: "r0", PodID: "pod-0", QueueDepth: 1}); err != nil {
+		t.Fatal(err)
+	}
+	if err := sink.Emit(30, &RequestScheduledEvent{ReqID: "r0", PodID: "pod-0", CachedTokens: 0, PrefixLookup: true}); err != nil {
+		t.Fatal(err)
+	}
+	if err := sink.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if err := sink.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := sink.Emit(60, &RequestQueuedEvent{ReqID: "r1", PodID: "pod-0", QueueDepth: 1}); err == nil {
+		t.Fatal("Emit after Close should fail")
+	}
+
+	recs := parseNDJSONLines(t, buf.Bytes())
+	if len(recs) != 4 {
+		t.Fatalf("got %d lines, want 4", len(recs))
+	}
+
+	// Header checks: no seq/t_us, non-null maps and initial_pods slice.
+	h := recs[0]
+	if h["type"] != "header" || h["schema_version"] != "1.0" {
+		t.Fatalf("unexpected header type/version: %v", h)
+	}
+	if _, hasSeq := h["seq"]; hasSeq {
+		t.Fatal("header must not contain seq")
+	}
+	if _, hasT := h["t_us"]; hasT {
+		t.Fatal("header must not contain t_us")
+	}
+	topo := h["topology"].(map[string]any)
+	if topo["initial_pods"] == nil {
+		t.Fatal("topology.initial_pods must serialize as [] not null")
+	}
+
+	wantTypes := []string{EventTypeRequestArrived, EventTypeRequestQueued, EventTypeRequestScheduled}
+	wantTUs := []float64{0, 50, 50}
+	for i := 1; i < len(recs); i++ {
+		if recs[i]["seq"] != float64(i-1) {
+			t.Errorf("record %d seq = %v, want %d", i, recs[i]["seq"], i-1)
+		}
+		if recs[i]["t_us"] != wantTUs[i-1] {
+			t.Errorf("record %d t_us = %v, want %v", i, recs[i]["t_us"], wantTUs[i-1])
+		}
+		if recs[i]["type"] != wantTypes[i-1] {
+			t.Errorf("record %d type = %v, want %s", i, recs[i]["type"], wantTypes[i-1])
+		}
+	}
+}
