+// assertEventsStreamInvariants verifies the NDJSON event log has a v1.0 header on line 1,
+// monotonic seq 0..N-1 and non-decreasing t_us on every subsequent line, and terminates with
+// a final metrics.snapshot record. Returns per-event-type counts.
+func assertEventsStreamInvariants(t *testing.T, data []byte) map[string]int {
+	t.Helper()
+
+	scanner := bufio.NewScanner(bytes.NewReader(data))
+	scanner.Buffer(make([]byte, 0, 64*1024), 16*1024*1024)
+
+	var lines [][]byte
+	for scanner.Scan() {
+		line := bytes.TrimSpace(scanner.Bytes())
+		if len(line) == 0 {
+			continue
+		}
+		cp := make([]byte, len(line))
+		copy(cp, line)
+		lines = append(lines, cp)
+	}
+	if err := scanner.Err(); err != nil {
+		t.Fatalf("scan events NDJSON: %v", err)
+	}
+	if len(lines) < 2 {
+		t.Fatalf("expected header plus at least one event, got %d lines", len(lines))
+	}
+
+	var hdr sim.HeaderRecord
+	if err := json.Unmarshal(lines[0], &hdr); err != nil {
+		t.Fatalf("line 1 header unmarshal: %v", err)
+	}
+	if hdr.Type != sim.EventTypeHeader {
+		t.Errorf("line 1 type = %q, want %q", hdr.Type, sim.EventTypeHeader)
+	}
+	if hdr.SchemaVersion != sim.SchemaVersionV1 {
+		t.Errorf("line 1 schema_version = %q, want %q", hdr.SchemaVersion, sim.SchemaVersionV1)
+	}
+
+	typeCounts := make(map[string]int)
+	var prevTUs int64
+	var lastType string
+	var lastIsFinal bool
+
+	for i, raw := range lines[1:] {
+		var rec struct {
+			Seq     uint64 `json:"seq"`
+			TUs     int64  `json:"t_us"`
+			Type    string `json:"type"`
+			IsFinal bool   `json:"is_final"`
+		}
+		if err := json.Unmarshal(raw, &rec); err != nil {
+			t.Fatalf("line %d unmarshal: %v", i+2, err)
+		}
+		if rec.Type == "" {
+			t.Fatalf("line %d has empty event type", i+2)
+		}
+		if rec.Type == sim.EventTypeHeader {
+			t.Fatalf("line %d has unexpected duplicate header", i+2)
+		}
+		wantSeq := uint64(i)
+		if rec.Seq != wantSeq {
+			t.Fatalf("line %d seq = %d, want %d", i+2, rec.Seq, wantSeq)
+		}
+		if rec.TUs < prevTUs {
+			t.Fatalf("line %d t_us = %d decreased below %d", i+2, rec.TUs, prevTUs)
+		}
+		prevTUs = rec.TUs
+		typeCounts[rec.Type]++
+		lastType = rec.Type
+		lastIsFinal = rec.IsFinal
+	}
+
+	if lastType != sim.EventTypeMetricsSnapshot || !lastIsFinal {
+		t.Errorf("final event = (%q, is_final=%v), want (%q, is_final=true)",
+			lastType, lastIsFinal, sim.EventTypeMetricsSnapshot)
+	}
+	return typeCounts
+}
