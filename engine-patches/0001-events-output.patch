+// SetEventSink installs or replaces the structured NDJSON event sink on a built driver.
+// When enabled, it also enables engine KV events and initializes the KV block tracker if needed.
+func (d *EngineDriver) SetEventSink(sink EventSink) {
+	d.cfg.EventSink = sink
+	if d.sinkEnabled() {
+		if p, ok := d.eng.(interface{ EnableKVEvents() }); ok {
+			p.EnableKVEvents()
+		}
+		if d.kvTracker == nil {
+			snap := d.eng.Snapshot()
+			blockSize := d.cfg.KVBlockSize
+			if blockSize <= 0 {
+				blockSize = snap.KVBlockSize
+			}
+			blocksTotal := d.cfg.KVBlocksTotal
+			if blocksTotal <= 0 {
+				blocksTotal = int(snap.KVBlocksTotal)
+			}
+			d.kvTracker = newKVBlockTracker(blockSize, blocksTotal)
+		}
+	}
+}
+
+// SetPodEventMeta populates pod-level metadata and roofline specification on the driver.
+func (d *EngineDriver) SetPodEventMeta(podID string, gpusPerPod, tpDegree, kvBlockSize, kvBlocksTotal int, roofline *ModelRooflineSpec, hasCPUOffload bool, cpuBlocksTotal int64) {
+	d.cfg.PodID = podID
+	if gpusPerPod > 0 {
+		d.cfg.GPUsPerPod = gpusPerPod
+	}
+	if tpDegree > 0 {
+		d.cfg.TPDegree = tpDegree
+	}
+	if kvBlockSize > 0 {
+		d.cfg.KVBlockSize = kvBlockSize
+	}
+	if kvBlocksTotal > 0 {
+		d.cfg.KVBlocksTotal = kvBlocksTotal
+	}
+	if roofline != nil {
+		d.cfg.RooflineSpec = roofline
+	}
+	d.cfg.HasCPUOffload = hasCPUOffload
+	if cpuBlocksTotal > 0 {
+		d.cfg.CPUBlocksTotal = cpuBlocksTotal
+	}
+	if d.sinkEnabled() && d.kvTracker == nil {
+		d.SetEventSink(d.cfg.EventSink)
+	}
+}
+
+// HasCPUOffload reports whether CPU RAM KV offload is configured on this driver.
+func (d *EngineDriver) HasCPUOffload() bool { return d.cfg.HasCPUOffload }
+
+// CPUBlocksTotal returns the configured CPU RAM KV cache capacity in blocks.
+func (d *EngineDriver) CPUBlocksTotal() int64 { return d.cfg.CPUBlocksTotal }
