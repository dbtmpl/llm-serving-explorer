@@ -0,0 +1,658 @@
+package cluster
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+
+	"github.com/sirupsen/logrus"
+
+	"github.com/inference-sim/inference-sim/sim"
+)
+
+const defaultEventSnapshotIntervalUs int64 = 1_000_000
+
+// SetEventSink installs the structured NDJSON event sink on the cluster and all existing instances.
+// Must be called before Run() (parallels SetProgressHook and SetGateway).
+func (c *ClusterSimulator) SetEventSink(sink sim.EventSink) {
+	if c.hasRun {
+		panic("ClusterSimulator: SetEventSink must be called before Run()")
+	}
+	c.eventSink = sink
+	if c.eventSnapshotIntervalUs <= 0 {
+		c.eventSnapshotIntervalUs = defaultEventSnapshotIntervalUs
+		c.nextEventSnapshotClockUs = c.eventSnapshotIntervalUs
+	}
+	for _, inst := range c.instances {
+		c.syncInstanceEventSink(inst)
+	}
+}
+
+// SetEventSnapshotInterval sets the simulation-clock interval in microseconds for periodic
+// metrics.snapshot emission when EventSink is enabled. Non-positive values keep the 1s default.
+func (c *ClusterSimulator) SetEventSnapshotInterval(intervalUs int64) {
+	if intervalUs > 0 {
+		c.eventSnapshotIntervalUs = intervalUs
+		c.nextEventSnapshotClockUs = intervalUs
+	}
+}
+
+func (c *ClusterSimulator) sinkEnabled() bool {
+	return c.eventSink != nil && c.eventSink.Enabled()
+}
+
+func (c *ClusterSimulator) emitClusterEvent(at int64, ev sim.EventRecord) {
+	if !c.sinkEnabled() {
+		return
+	}
+	if at < 0 {
+		at = 0
+	}
+	if err := c.eventSink.Emit(at, ev); err != nil {
+		logrus.Warnf("[cluster] event sink emit failed (%s at %d): %v", ev.EventType(), at, err)
+	}
+}
+
+func (c *ClusterSimulator) poolRoleString(instID InstanceID) string {
+	if c.poolMembership == nil {
+		return "colocated"
+	}
+	role := c.poolMembership[string(instID)]
+	switch role {
+	case PoolRolePrefill:
+		return "prefill"
+	case PoolRoleDecode:
+		return "decode"
+	case PoolRoleEncode:
+		return "encode"
+	default:
+		return "colocated"
+	}
+}
+
+func (c *ClusterSimulator) rooflineForInstance(inst *InstanceSimulator) *sim.ModelRooflineSpec {
+	role := c.poolRoleString(inst.ID())
+	if c.config.RooflineSpecsByRole != nil {
+		if spec := c.config.RooflineSpecsByRole[role]; spec != nil {
+			return spec
+		}
+	}
+	return c.config.RooflineSpec
+}
+
+func (c *ClusterSimulator) effectiveTPDegree(inst *InstanceSimulator) int {
+	if inst.TPDegree > 0 {
+		return inst.TPDegree
+	}
+	cfg := c.config.InstanceConfig
+	if c.poolMembership != nil {
+		cfg = c.config.resolveConfigForRole(c.poolMembership[string(inst.ID())])
+	}
+	if cfg.TP > 0 {
+		return cfg.TP
+	}
+	return 1
+}
+
+func (c *ClusterSimulator) effectiveGPUIDs(inst *InstanceSimulator) []string {
+	if len(inst.allocatedGPUIDs) > 0 {
+		out := make([]string, len(inst.allocatedGPUIDs))
+		copy(out, inst.allocatedGPUIDs)
+		return out
+	}
+	tp := c.effectiveTPDegree(inst)
+	dpRanks := max(c.config.DPLockstepRanks, 1)
+	count := max(tp*dpRanks, 1)
+	out := make([]string, count)
+	for i := 0; i < count; i++ {
+		out[i] = fmt.Sprintf("%s-gpu-%d", inst.ID(), i)
+	}
+	return out
+}
+
+func (c *ClusterSimulator) syncInstanceEventSink(inst *InstanceSimulator) {
+	if inst == nil {
+		return
+	}
+	tp := c.effectiveTPDegree(inst)
+	gpuIDs := c.effectiveGPUIDs(inst)
+	blockSize := int(c.config.BlockSizeTokens)
+	if blockSize <= 0 {
+		blockSize = 16
+	}
+	blocksTotal := int(inst.TotalKVBlocks())
+	inst.SetPodEventMeta(len(gpuIDs), tp, blockSize, blocksTotal, c.rooflineForInstance(inst), c.config.HasCPUOffload, c.config.CPUBlocksTotal)
+	inst.SetEventSink(c.eventSink)
+}
+
+// InitialPodsInfo returns the schema-formatted InitialPod metadata for all startup instances.
+func (c *ClusterSimulator) InitialPodsInfo() []sim.InitialPod {
+	pods := make([]sim.InitialPod, 0, len(c.instances))
+	for _, inst := range c.instances {
+		pods = append(pods, sim.InitialPod{
+			PodID:    string(inst.ID()),
+			PoolRole: c.poolRoleString(inst.ID()),
+			GPUIDs:   c.effectiveGPUIDs(inst),
+			TPDegree: c.effectiveTPDegree(inst),
+			State:    schemaInitialPodState(inst.State),
+		})
+	}
+	return pods
+}
+
+func schemaInitialPodState(s sim.InstanceState) string {
+	switch s {
+	case sim.InstanceStateScheduling, sim.InstanceStateLoading:
+		return "loading"
+	case sim.InstanceStateDraining:
+		return "draining"
+	case sim.InstanceStateTerminated:
+		return "terminated"
+	default:
+		return "ready"
+	}
+}
+
+func schemaSnapshotPodState(s sim.InstanceState) string {
+	switch s {
+	case sim.InstanceStateScheduling, sim.InstanceStateLoading:
+		return "loading"
+	case sim.InstanceStateWarmingUp:
+		return "warming_up"
+	case sim.InstanceStateDraining:
+		return "draining"
+	case sim.InstanceStateTerminated:
+		return "terminated"
+	case sim.InstanceStateActive:
+		return "active"
+	default:
+		return "ready"
+	}
+}
+
+func (c *ClusterSimulator) emitInitialPodEvents() {
+	if c.initialPodsEmitted || !c.sinkEnabled() {
+		return
+	}
+	c.initialPodsEmitted = true
+	for _, inst := range c.instances {
+		role := c.poolRoleString(inst.ID())
+		c.emitClusterEvent(0, &sim.PodCreatedEvent{
+			PodID:    string(inst.ID()),
+			PoolRole: role,
+			GPUIDs:   c.effectiveGPUIDs(inst),
+			TPDegree: c.effectiveTPDegree(inst),
+			NodeID:   inst.nodeID,
+		})
+		switch inst.State {
+		case sim.InstanceStateScheduling, sim.InstanceStateLoading:
+			c.emitClusterEvent(0, &sim.PodLoadingEvent{
+				PodID:    string(inst.ID()),
+				PoolRole: role,
+			})
+		case sim.InstanceStateWarmingUp, sim.InstanceStateActive, "":
+			inst.readyEmitted = true
+			c.emitClusterEvent(0, &sim.PodReadyEvent{
+				PodID:    string(inst.ID()),
+				PoolRole: role,
+			})
+		case sim.InstanceStateDraining:
+			reason := inst.drainReason
+			if reason == "" {
+				reason = "drain"
+			}
+			c.emitClusterEvent(0, &sim.PodDrainingEvent{
+				PodID:    string(inst.ID()),
+				PoolRole: role,
+				Reason:   reason,
+			})
+		case sim.InstanceStateTerminated:
+			c.emitClusterEvent(0, &sim.PodTerminatedEvent{
+				PodID:    string(inst.ID()),
+				PoolRole: role,
+			})
+		}
+	}
+}
+
+func (c *ClusterSimulator) emitPodCreatedAndLoading(inst *InstanceSimulator) {
+	if !c.sinkEnabled() {
+		return
+	}
+	role := c.poolRoleString(inst.ID())
+	c.emitClusterEvent(c.clock, &sim.PodCreatedEvent{
+		PodID:    string(inst.ID()),
+		PoolRole: role,
+		GPUIDs:   c.effectiveGPUIDs(inst),
+		TPDegree: c.effectiveTPDegree(inst),
+		NodeID:   inst.nodeID,
+	})
+	c.emitClusterEvent(c.clock, &sim.PodLoadingEvent{
+		PodID:    string(inst.ID()),
+		PoolRole: role,
+	})
+}
+
+func (c *ClusterSimulator) emitPodTransitionEvent(inst *InstanceSimulator) {
+	if !c.sinkEnabled() {
+		return
+	}
+	role := c.poolRoleString(inst.ID())
+	switch inst.State {
+	case sim.InstanceStateLoading:
+		c.emitClusterEvent(c.clock, &sim.PodLoadingEvent{
+			PodID:    string(inst.ID()),
+			PoolRole: role,
+		})
+	case sim.InstanceStateWarmingUp, sim.InstanceStateActive:
+		if inst.readyEmitted {
+			return
+		}
+		inst.readyEmitted = true
+		c.emitClusterEvent(c.clock, &sim.PodReadyEvent{
+			PodID:    string(inst.ID()),
+			PoolRole: role,
+		})
+	case sim.InstanceStateDraining:
+		reason := inst.drainReason
+		if reason == "" {
+			reason = "drain"
+		}
+		c.emitClusterEvent(c.clock, &sim.PodDrainingEvent{
+			PodID:    string(inst.ID()),
+			PoolRole: role,
+			Reason:   reason,
+		})
+	case sim.InstanceStateTerminated:
+		c.emitClusterEvent(c.clock, &sim.PodTerminatedEvent{
+			PodID:    string(inst.ID()),
+			PoolRole: role,
+		})
+	}
+}
+
+func (c *ClusterSimulator) emitRequestArrived(req *sim.Request, at int64) {
+	if !c.sinkEnabled() || req == nil {
+		return
+	}
+	maxOut := max(req.MaxOutputLen, 0)
+	var blockHashes []string
+	if bs := int(c.config.BlockSizeTokens); bs > 0 && len(req.InputTokens) >= bs {
+		numBlocks := len(req.InputTokens) / bs
+		blockHashes = make([]string, 0, numBlocks)
+		prev := ""
+		for i := 0; i < numBlocks; i++ {
+			chunk := req.InputTokens[i*bs : (i+1)*bs]
+			prev = hashPromptBlock(prev, chunk)
+			blockHashes = append(blockHashes, prev)
+		}
+	}
+	c.emitClusterEvent(at, &sim.RequestArrivedEvent{
+		ReqID:           req.ID,
+		PromptTokens:    len(req.InputTokens),
+		MaxOutputTokens: maxOut,
+		PrefixGroup:     req.PrefixGroup,
+		PrefixTokens:    max(req.PrefixLength, 0),
+		BlockHashes:     blockHashes,
+		SLOClass:        req.SLOClass,
+		SessionID:       req.SessionID,
+	})
+}
+
+func hashPromptBlock(prevHash string, tokens []sim.TokenID) string {
+	h := sha256.New()
+	h.Write([]byte(prevHash))
+	var buf [20]byte
+	for _, t := range tokens {
+		b := strconv.AppendInt(buf[:0], int64(t), 10)
+		b = append(b, '|')
+		h.Write(b)
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+func (c *ClusterSimulator) emitRequestRouted(req *sim.Request, p Placement) {
+	if !c.sinkEnabled() || req == nil {
+		return
+	}
+	c.emitClusterEvent(c.clock, &sim.RequestAdmittedEvent{
+		ReqID:  req.ID,
+		Reason: "admitted",
+	})
+	disagg := p.Prefill != ""
+	chosenPod := string(p.Decode)
+	if disagg {
+		chosenPod = string(p.Prefill)
+	}
+	var candidates []sim.CandidateScore
+	var regretPtr *float64
+	if len(p.Scores) > 0 {
+		scoredChosen := string(p.Decode)
+		if _, ok := p.Scores[scoredChosen]; !ok && p.Prefill != "" {
+			scoredChosen = string(p.Prefill)
+		}
+		traceCands, regret := c.counterfactual(scoredChosen, p.Scores, len(p.Scores))
+		candidates = make([]sim.CandidateScore, 0, len(traceCands))
+		for _, tc := range traceCands {
+			kvUtil := tc.KVUtilization
+			if math.IsNaN(kvUtil) || math.IsInf(kvUtil, 0) || kvUtil < 0 {
+				kvUtil = 0
+			} else if kvUtil > 1 {
+				kvUtil = 1
+			}
+			candidates = append(candidates, sim.CandidateScore{
+				PodID:            tc.InstanceID,
+				Score:            tc.Score,
+				QueueDepth:       max(tc.QueueDepth, 0),
+				BatchSize:        max(tc.BatchSize, 0),
+				InFlightRequests: max(tc.InFlightRequests, 0),
+				KVUtilization:    kvUtil,
+				FreeKVBlocks:     max(tc.FreeKVBlocks, 0),
+			})
+		}
+		regretPtr = &regret
+	}
+	c.emitClusterEvent(c.clock, &sim.RequestRoutedEvent{
+		ReqID:        req.ID,
+		ChosenPod:    chosenPod,
+		PrefillPod:   string(p.Prefill),
+		DecodePod:    string(p.Decode),
+		Disaggregate: disagg,
+		Reason:       "llm-d",
+		Scores:       copyScores(p.Scores),
+		Candidates:   candidates,
+		Regret:       regretPtr,
+	})
+}
+
+func (c *ClusterSimulator) emitGatewayRejection(req *sim.Request, why Rejection, reason string) {
+	if !c.sinkEnabled() || req == nil {
+		return
+	}
+	if why == RejectedClientTimeout {
+		c.emitClusterEvent(c.clock, &sim.RequestTimedOutEvent{
+			ReqID:     req.ID,
+			Stage:     "gateway",
+			ElapsedUS: max(c.clock-req.ArrivalTime, 0),
+		})
+		return
+	}
+	stage := "admission"
+	switch why {
+	case RejectedAdmission:
+		stage = "admission"
+	case RejectedGatewayCapacity, RejectedGatewayExpired:
+		stage = "flow_control"
+	case RejectedRouting:
+		stage = "routing"
+	case RejectedUnservable:
+		stage = "unservable"
+	}
+	c.emitClusterEvent(c.clock, &sim.RequestRejectedEvent{
+		ReqID:  req.ID,
+		Reason: reason,
+		Stage:  stage,
+	})
+}
+
+func (c *ClusterSimulator) emitDecodeKVRejection(reqID string, at int64, reason string) {
+	if !c.sinkEnabled() || reqID == "" {
+		return
+	}
+	c.emitClusterEvent(at, &sim.RequestRejectedEvent{
+		ReqID:  reqID,
+		Reason: reason,
+		Stage:  "decode_kv",
+	})
+}
+
+func (c *ClusterSimulator) emitKVTransferStarted(parent *ParentRequest, at int64) {
+	if !c.sinkEnabled() || parent == nil {
+		return
+	}
+	c.nextTransferSeq++
+	tid := c.nextTransferSeq
+	c.transferIDs[parent.ID] = tid
+	c.emitClusterEvent(at, &sim.KVTransferEvent{
+		TransferID:     &tid,
+		ReqID:          parent.ID,
+		FromPod:        string(parent.PrefillInstanceID),
+		ToPod:          string(parent.DecodeInstanceID),
+		NumKVBlocks:    int(max(parent.NumKVBlocks, 0)),
+		PulledKVBlocks: int(max(parent.PulledKVBlocks, 0)),
+		DurationUS:     0,
+		Status:         "started",
+	})
+}
+
+func (c *ClusterSimulator) emitKVTransferCompleted(parent *ParentRequest, at int64, durationUS int64) {
+	if !c.sinkEnabled() || parent == nil {
+		return
+	}
+	var tidPtr *uint64
+	if tid, ok := c.transferIDs[parent.ID]; ok {
+		tidCopy := tid
+		tidPtr = &tidCopy
+		delete(c.transferIDs, parent.ID)
+	}
+	c.emitClusterEvent(at, &sim.KVTransferEvent{
+		TransferID:     tidPtr,
+		ReqID:          parent.ID,
+		FromPod:        string(parent.PrefillInstanceID),
+		ToPod:          string(parent.DecodeInstanceID),
+		NumKVBlocks:    int(max(parent.NumKVBlocks, 0)),
+		PulledKVBlocks: int(max(parent.PulledKVBlocks, 0)),
+		DurationUS:     max(durationUS, 0),
+		Status:         "completed",
+	})
+}
+
+func (c *ClusterSimulator) maybeEmitMetricsSnapshot(isFinal bool) {
+	if !c.sinkEnabled() {
+		return
+	}
+	if !isFinal && (c.eventSnapshotIntervalUs <= 0 || c.clock < c.nextEventSnapshotClockUs) {
+		return
+	}
+
+	snapTime := c.clock
+	flushUpTo := c.clock
+	if isFinal {
+		snapTime = min(c.clock, c.config.Horizon)
+		flushUpTo = math.MaxInt64
+	}
+	if snapTime < 0 {
+		snapTime = 0
+	}
+
+	// Flush deferred driver step-end events so step/KV events precede or align with snapshot.
+	for _, inst := range c.instances {
+		inst.FlushSinkEvents(flushUpTo)
+	}
+
+	instances := make([]sim.InstanceMetricsSnapshot, 0, len(c.instances))
+	for _, inst := range c.instances {
+		totalKV := max(inst.TotalKVBlocks(), 0)
+		usedKV := max(inst.UsedKVBlocks(), 0)
+		if totalKV > 0 && usedKV > totalKV {
+			usedKV = totalKV
+		}
+		freeKV := max(totalKV-usedKV, 0)
+		cachedKV := max(inst.CachedKVBlocksCount(), 0)
+		if totalKV > 0 && cachedKV > totalKV {
+			cachedKV = totalKV
+		}
+		item := sim.InstanceMetricsSnapshot{
+			PodID:             string(inst.ID()),
+			State:             schemaSnapshotPodState(inst.State),
+			QueueDepth:        max(inst.QueueDepth(), 0),
+			BatchSize:         max(inst.BatchSize(), 0),
+			KVUsedBlocks:      usedKV,
+			KVCachedBlocks:    cachedKV,
+			KVFreeBlocks:      freeKV,
+			KVTotalBlocks:     totalKV,
+			Preemptions:       max(int64(inst.PreemptionCount()), 0),
+			CompletedRequests: max(inst.Metrics().CompletedRequests, 0),
+		}
+		if inst.HasCPUOffload() || inst.CPUBlocksTotal() > 0 {
+			cpuUsed := int64(len(inst.CPUBlockHashes()))
+			cpuTotal := max(inst.CPUBlocksTotal(), cpuUsed)
+			item.CPUUsedBlocks = &cpuUsed
+			item.CPUTotalBlocks = &cpuTotal
+		}
+		instances = append(instances, item)
+	}
+
+	completed, preemptions, rejected, timedOut, dropped, ttftMeanMs, tpotMeanMs, outputTokS, hitRate := c.snapshotSummaryMetrics(isFinal, snapTime)
+
+	c.emitClusterEvent(snapTime, &sim.MetricsSnapshotEvent{
+		IsFinal:            isFinal,
+		GatewayQueueDepth:  max(c.GatewayQueueDepth(), 0),
+		CompletedRequests:  max(completed, 0),
+		Preemptions:        max(preemptions, 0),
+		RejectedRequests:   max(rejected, 0),
+		TimedOutRequests:   max(timedOut, 0),
+		DroppedRequests:    max(dropped, 0),
+		TTFTMeanMs:         sanitizeNonNegFloat(ttftMeanMs),
+		TPOTMeanMs:         sanitizeNonNegFloat(tpotMeanMs),
+		OutputTokS:         sanitizeNonNegFloat(outputTokS),
+		PrefixCacheHitRate: clamp01(hitRate),
+		Instances:          instances,
+	})
+
+	if !isFinal && c.eventSnapshotIntervalUs > 0 {
+		for c.nextEventSnapshotClockUs <= c.clock {
+			c.nextEventSnapshotClockUs += c.eventSnapshotIntervalUs
+		}
+	}
+}
+
+func (c *ClusterSimulator) snapshotSummaryMetrics(isFinal bool, snapTime int64) (completed int, preemptions int64, rejected, timedOut, dropped int, ttftMeanMs, tpotMeanMs, outputTokS, hitRate float64) {
+	preemptions = c.preemptionsTotal()
+	rejected = c.rejectedRequests + c.routingRejections + c.gatewayRejected + c.gatewayExpired
+
+	if isFinal && c.aggregatedMetrics != nil {
+		m := c.aggregatedMetrics
+		completed = m.CompletedRequests
+		timedOut = m.TimedOutRequests
+		dropped = m.DroppedUnservable
+		ttftMeanMs = meanUsToMs(m.RequestTTFTs)
+		tpotMeanMs = meanUsToMs(m.RequestITLs)
+		if m.SimEndedTime > 0 && m.CompletedRequests > 0 {
+			outputTokS = float64(m.TotalOutputTokens) / (float64(m.SimEndedTime) / 1e6)
+		}
+		hitRate = m.CacheHitRate
+		return
+	}
+
+	completed = c.completedRequestsTotal() - c.pdPrefillCompletedCount
+	if completed < 0 {
+		completed = 0
+	}
+	timedOut = c.timedOutRequestsTotal()
+	dropped = c.droppedRequestsTotal()
+
+	var totalOutTokens int
+	var queryTokens, hitTokens int64
+	var ttftSumUs, itlSumUs float64
+	var ttftCount, itlCount int
+
+	for _, inst := range c.instances {
+		m := inst.Metrics()
+		totalOutTokens += m.TotalOutputTokens
+		queryTokens += m.PrefixCacheQueryTokens
+		hitTokens += m.PrefixCacheHitTokens
+
+		// Skip PD prefill sub-requests in live mean latency so decode latency is represented cleanly.
+		isPrefillOnly := c.poolsConfigured() && c.poolMembership[string(inst.ID())] == PoolRolePrefill
+		if isPrefillOnly {
+			continue
+		}
+		ttftKeys := make([]string, 0, len(m.RequestTTFTs))
+		for id := range m.RequestTTFTs {
+			ttftKeys = append(ttftKeys, id)
+		}
+		sort.Strings(ttftKeys)
+		for _, id := range ttftKeys {
+			v := m.RequestTTFTs[id]
+			if !math.IsNaN(v) && !math.IsInf(v, 0) && v >= 0 {
+				ttftSumUs += v
+				ttftCount++
+			}
+		}
+		itlKeys := make([]string, 0, len(m.RequestITLs))
+		for id := range m.RequestITLs {
+			itlKeys = append(itlKeys, id)
+		}
+		sort.Strings(itlKeys)
+		for _, id := range itlKeys {
+			v := m.RequestITLs[id]
+			if !math.IsNaN(v) && !math.IsInf(v, 0) && v >= 0 {
+				itlSumUs += v
+				itlCount++
+			}
+		}
+	}
+
+	totalOutTokens -= c.pdPrefillOutputTokens
+	if totalOutTokens < 0 {
+		totalOutTokens = 0
+	}
+	if snapTime > 0 && totalOutTokens > 0 {
+		outputTokS = float64(totalOutTokens) / (float64(snapTime) / 1e6)
+	}
+	if ttftCount > 0 {
+		ttftMeanMs = (ttftSumUs / float64(ttftCount)) / 1000.0
+	}
+	if itlCount > 0 {
+		tpotMeanMs = (itlSumUs / float64(itlCount)) / 1000.0
+	}
+	if queryTokens > 0 {
+		hitRate = float64(hitTokens) / float64(queryTokens)
+	}
+	return
+}
+
+func meanUsToMs(m map[string]float64) float64 {
+	if len(m) == 0 {
+		return 0
+	}
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var sum float64
+	var n int
+	for _, k := range keys {
+		v := m[k]
+		if !math.IsNaN(v) && !math.IsInf(v, 0) && v >= 0 {
+			sum += v
+			n++
+		}
+	}
+	if n == 0 {
+		return 0
+	}
+	return (sum / float64(n)) / 1000.0
+}
+
+func sanitizeNonNegFloat(v float64) float64 {
+	if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 {
+		return 0
+	}
+	return v
+}
+
+func clamp01(v float64) float64 {
+	if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 {
+		return 0
+	}
+	if v > 1 {
+		return 1
+	}
+	return v
+}
