+package cmd
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"runtime/debug"
+	"strings"
+
+	"github.com/sirupsen/logrus"
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+
+	"github.com/inference-sim/inference-sim/internal/stack"
+	"github.com/inference-sim/inference-sim/sim"
+	"github.com/inference-sim/inference-sim/sim/cluster"
+)
+
+var eventsOutput string
+
+func registerEventsOutputFlag(cmd *cobra.Command) {
+	cmd.Flags().StringVar(&eventsOutput, "events-output", "", "Path to write structured NDJSON simulation event log (schema v1.0)")
+}
+
+type eventStreamSession struct {
+	file *os.File
+	sink *sim.JSONLEventSink
+}
+
+func setupEventStream(cmd *cobra.Command, cfg *cluster.DeploymentConfig, horizonUs int64, r routerInputs) (*eventStreamSession, *sim.HeaderRecord) {
+	if eventsOutput == "" {
+		return nil, nil
+	}
+
+	if dir := filepath.Dir(eventsOutput); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			logrus.Fatalf("--events-output %s: %v", eventsOutput, err)
+		}
+	}
+	f, err := os.Create(eventsOutput)
+	if err != nil {
+		logrus.Fatalf("--events-output %s: %v", eventsOutput, err)
+	}
+
+	pools, rooflineByRole, defaultRoofline, tiers := buildEventTopologySpecs(cfg.InstanceConfig)
+	cfg.RooflineSpec = defaultRoofline
+	cfg.RooflineSpecsByRole = rooflineByRole
+	cfg.HasCPUOffload = tiers.CPURAMBlocks > 0
+	cfg.CPUBlocksTotal = tiers.CPURAMBlocks
+
+	scenarioName := kernelScenario
+	if scenarioName == "" {
+		scenarioName = cfg.Model
+	}
+	if scenarioName == "" {
+		scenarioName = model
+	}
+	if scenarioName == "" {
+		scenarioName = "unnamed"
+	}
+
+	modelName := cfg.Model
+	if modelName == "" {
+		modelName = model
+	}
+	if modelName == "" {
+		modelName = "unknown"
+	}
+
+	hwName := cfg.GPU
+	if hwName == "" {
+		hwName = gpu
+	}
+	if hwName == "" {
+		hwName = "unknown"
+	}
+
+	flagsMap := make(map[string]any)
+	cmd.Flags().Visit(func(fl *pflag.Flag) {
+		if fl.Name == "events-output" {
+			return
+		}
+		flagsMap[fl.Name] = fl.Value.String()
+	})
+
+	if horizonUs < 0 {
+		horizonUs = 0
+	}
+	gwLat := r.GatewayLatencyUs
+	if gwLat <= 0 {
+		gwLat = gatewayLatencyUs
+	}
+	if gwLat < 0 {
+		gwLat = 0
+	}
+	routingPolicy := "llm-d"
+	if len(r.EPPFlags) > 0 {
+		routingPolicy = "llm-d:" + strings.Join(r.EPPFlags, ",")
+	}
+
+	hdr := &sim.HeaderRecord{
+		Type:          sim.EventTypeHeader,
+		SchemaVersion: sim.SchemaVersionV1,
+		BLIS:          buildHeaderBLIS(),
+		Scenario: sim.HeaderScenario{
+			Name:          scenarioName,
+			Model:         modelName,
+			Hardware:      hwName,
+			Flags:         flagsMap,
+			Seed:          seed,
+			HorizonUS:     horizonUs,
+			RoutingPolicy: routingPolicy,
+		},
+		Topology: sim.HeaderTopology{
+			GatewayLatencyUS: gwLat,
+			Pools:            pools,
+			Tiers:            tiers,
+		},
+	}
+
+	sink := sim.NewJSONLEventSink(f)
+	return &eventStreamSession{file: f, sink: sink}, hdr
+}
+
+func (s *eventStreamSession) attachAndWriteHeader(cs *cluster.ClusterSimulator, hdr *sim.HeaderRecord) {
+	if s == nil || hdr == nil {
+		return
+	}
+	hdr.Topology.InitialPods = cs.InitialPodsInfo()
+	if err := s.sink.WriteHeader(hdr); err != nil {
+		_ = s.file.Close()
+		logrus.Fatalf("--events-output %s: write header: %v", eventsOutput, err)
+	}
+	cs.SetEventSink(s.sink)
+}
+
+func (s *eventStreamSession) finish() {
+	if s == nil {
+		return
+	}
+	if err := s.sink.Close(); err != nil {
+		logrus.Warnf("--events-output %s: close failed: %v", eventsOutput, err)
+	}
+}
+
+func buildHeaderBLIS() sim.HeaderBLIS {
+	out := sim.HeaderBLIS{
+		Commit:        "unknown",
+		VLLMVersion:   "unknown",
+		LLMDVersion:   "unknown",
+		StackVersions: map[string]string{},
+	}
+
+	for _, up := range EngineReleases() {
+		if up.Kind == "vllm" && up.Version != "" {
+			out.VLLMVersion = up.Version
+		}
+		if len(up.Commit) >= 7 && out.Commit == "unknown" {
+			out.Commit = up.Commit
+		}
+		if up.Kind != "" && up.Version != "" {
+			out.StackVersions["engine:"+up.Kind] = up.Version
+		}
+	}
+
+	if bi, ok := debug.ReadBuildInfo(); ok {
+		for _, setting := range bi.Settings {
+			if setting.Key == "vcs.revision" && len(setting.Value) >= 7 {
+				out.Commit = setting.Value
+				break
+			}
+		}
+		for _, dep := range bi.Deps {
+			switch dep.Path {
+			case stack.SubstrateModule, stack.VLLMModule, stack.RouterModule, stack.RouterFork:
+				out.StackVersions[dep.Path] = dep.Version
+				if (dep.Path == stack.RouterModule || dep.Path == stack.RouterFork) && dep.Version != "" {
+					out.LLMDVersion = dep.Version
+				}
+			}
+		}
+	}
+
+	for _, candidate := range []string{"stack.json", filepath.Join("engine", "stack.json")} {
+		data, err := os.ReadFile(candidate)
+		if err != nil {
+			continue
+		}
+		var st stack.Stack
+		if err := json.Unmarshal(data, &st); err != nil {
+			continue
+		}
+		if st.Router.Version != "" {
+			out.LLMDVersion = st.Router.Version
+		}
+		if st.Toolchain != "" {
+			out.StackVersions["toolchain"] = st.Toolchain
+		}
+		for _, m := range st.Modules {
+			if m.Path != "" && m.Version != "" {
+				out.StackVersions[m.Path] = m.Version
+			}
+		}
+		for _, e := range st.Engines {
+			if e.Kind == "vllm" && e.Version != "" {
+				out.VLLMVersion = e.Version
+			}
+		}
+		break
+	}
+
+	return out
+}
