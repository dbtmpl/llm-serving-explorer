+func TestModelRooflineSpec_EstimateBatch(t *testing.T) {
+	spec := &ModelRooflineSpec{
+		ModelName:              "llama-8b",
+		HiddenSize:             4096,
+		IntermediateSize:       14336,
+		NumHiddenLayers:        32,
+		NumAttentionHeads:      32,
+		NumKVHeads:             8,
+		HeadDim:                128,
+		VocabSize:              128256,
+		WeightBytesPerRank:     16_000_000_000,
+		KVBytesPerTokenPerRank: 131072,
+		TP:                     1,
+		PP:                     1,
+		ChipTFLOPsPeak:         989,
+		ChipTFLOPsFP8:          1979,
+		ChipBWTBs:              3.35,
+		IsFP8:                  false,
+	}
+
+	// Large prefill -> compute-bound.
+	prefillBatch := engine.Batch{
+		ID:   1,
+		Reqs: []engine.Scheduled{{ID: "r0", Tokens: 2048, Computed: 0, PromptLen: 2048}},
+	}
+	rp := spec.EstimateBatch(prefillBatch, 20_000)
+	if !rp.Derived {
+		t.Fatal("expected Derived == true")
+	}
+	if rp.Bottleneck != "compute" {
+		t.Errorf("prefill bottleneck = %q, want compute (AI=%.2f)", rp.Bottleneck, rp.ArithmeticIntensity)
+	}
+	if rp.FLOPs <= 0 || rp.BytesMoved <= 0 || rp.AchievedTFLOPs <= 0 || rp.AchievedBWTBs <= 0 {
+		t.Errorf("expected positive roofline metrics, got %+v", rp)
+	}
+
+	// Single-token decode -> memory_bw-bound.
+	decodeBatch := engine.Batch{
+		ID:   2,
+		Reqs: []engine.Scheduled{{ID: "r0", Tokens: 1, Computed: 512, PromptLen: 512}},
+	}
+	rd := spec.EstimateBatch(decodeBatch, 5_000)
+	if rd.Bottleneck != "memory_bw" {
+		t.Errorf("decode bottleneck = %q, want memory_bw (AI=%.2f)", rd.Bottleneck, rd.ArithmeticIntensity)
+	}
+
+	// MoE + FP8 + durationUS <= 0 safeguard -> no NaN/Inf.
+	moeSpec := *spec
+	moeSpec.IsMoE = true
+	moeSpec.NumExperts = 8
+	moeSpec.ExpertsPerTok = 2
+	moeSpec.IsFP8 = true
+	rmoe := moeSpec.EstimateBatch(decodeBatch, 0)
+	for _, v := range []float64{rmoe.FLOPs, rmoe.BytesMoved, rmoe.ArithmeticIntensity, rmoe.AchievedTFLOPs, rmoe.AchievedBWTBs} {
+		if math.IsNaN(v) || math.IsInf(v, 0) {
+			t.Fatalf("unexpected NaN/Inf in roofline: %+v", rmoe)
+		}
+	}
+
+	// Empty batch -> zero metrics, memory_bw, Derived: true.
+	rempty := spec.EstimateBatch(engine.Batch{ID: 3}, 0)
+	if rempty.FLOPs != 0 || rempty.BytesMoved != 0 || rempty.Bottleneck != "memory_bw" || !rempty.Derived {
+		t.Errorf("unexpected empty batch roofline: %+v", rempty)
+	}
+}
