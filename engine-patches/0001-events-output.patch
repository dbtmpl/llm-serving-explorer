+// buildEventTopologySpecs extracts schema-compliant PoolConfig metadata and ModelRooflineSpec
+// for each active pool from the opened kernelmodel and substrate catalog.
+func buildEventTopologySpecs(ic sim.InstanceConfig) (pools []sim.PoolConfig, rooflineByRole map[string]*sim.ModelRooflineSpec, defaultRoofline *sim.ModelRooflineSpec, tiers sim.HeaderTiers) {
+	rooflineByRole = make(map[string]*sim.ModelRooflineSpec)
+	fallbackEC := engineConfigIn(ic)
+
+	if kernelPDOpened != nil {
+		if prefillInstances > 0 && kernelPDOpened.prefill != nil {
+			pCfg, spec := poolSpecFromModel(kernelPDOpened.prefill, "prefill", prefillInstances, fallbackEC)
+			pools = append(pools, pCfg)
+			if spec != nil {
+				rooflineByRole["prefill"] = spec
+			}
+		}
+		if decodeInstances > 0 && kernelPDOpened.decode != nil {
+			pCfg, spec := poolSpecFromModel(kernelPDOpened.decode, "decode", decodeInstances, fallbackEC)
+			pools = append(pools, pCfg)
+			if spec != nil {
+				rooflineByRole["decode"] = spec
+			}
+		}
+		if prefillDecodeInstances > 0 {
+			pCfg, spec := poolSpecFromModel(kernelOpened, "colocated", prefillDecodeInstances, fallbackEC)
+			pools = append(pools, pCfg)
+			if spec != nil {
+				rooflineByRole["colocated"] = spec
+				defaultRoofline = spec
+			}
+		}
+		if encodeInstances > 0 {
+			pCfg, _ := poolSpecFromModel(kernelOpened, "encode", encodeInstances, fallbackEC)
+			pools = append(pools, pCfg)
+		}
+	}
+	if len(pools) == 0 {
+		pCfg, spec := poolSpecFromModel(kernelOpened, "colocated", max(numInstances, 0), fallbackEC)
+		pools = append(pools, pCfg)
+		if spec != nil {
+			rooflineByRole["colocated"] = spec
+			defaultRoofline = spec
+		}
+	}
+	if defaultRoofline == nil {
+		if spec := rooflineByRole["decode"]; spec != nil {
+			defaultRoofline = spec
+		} else if spec := rooflineByRole["prefill"]; spec != nil {
+			defaultRoofline = spec
+		}
+	}
+
+	var gpuHBMBlocks int64
+	for _, p := range pools {
+		gpuHBMBlocks += p.KVBlocksPerGPU * int64(max(p.GPUsPerPod, 1)) * int64(max(p.Replicas, 0))
+	}
+	if gpuHBMBlocks == 0 {
+		gpuHBMBlocks = totalKVBlocks * int64(max(numInstances, 1))
+	}
+
+	cpuRAMBlocks, cpuRAMBytes := resolveEventCPUTier(fallbackEC.KVCacheConfig.Offload, fallbackEC.KVCacheConfig.BlockSizeTokens)
+	localSSD, remoteStore := false, false
+	for _, t := range fallbackEC.KVCacheConfig.Offload.Tiers {
+		switch strings.ToLower(t.Type) {
+		case "local_storage", "ssd", "nvme", "disk":
+			localSSD = true
+		case "shared_storage", "remote", "s3", "nfs":
+			remoteStore = true
+		}
+	}
+
+	tiers = sim.HeaderTiers{
+		GPUHBMBlocks:        max(gpuHBMBlocks, 0),
+		CPURAMBlocks:        max(cpuRAMBlocks, 0),
+		CPURAMBytes:         max(cpuRAMBytes, 0),
+		LocalSSDModelled:    localSSD,
+		RemoteStoreModelled: remoteStore,
+		UnmodelledNotes:     map[string]string{},
+	}
+	return pools, rooflineByRole, defaultRoofline, tiers
+}
+
+func resolveEventCPUTier(offload kvOffloadConfig, fallbackBlockTokens int64) (blocks, bytes int64) {
+	if offload.IsEnabled() {
+		if offload.CPUBytesToUse > 0 {
+			bytes = offload.CPUBytesToUse
+			if offload.PerBlockBytes > 0 {
+				blocks = offload.CPUBytesToUse / offload.PerBlockBytes
+			}
+		}
+	}
+	if kvCPUBlocks > blocks {
+		blocks = kvCPUBlocks
+		if offload.PerBlockBytes > 0 && bytes == 0 {
+			bytes = blocks * offload.PerBlockBytes
+		}
+	}
+	if blocks > 0 && bytes == 0 {
+		// Fallback estimate only when PerBlockBytes was not computed by offload config.
+		bytes = blocks * max(fallbackBlockTokens, 16) * 1024
+	}
+	return blocks, bytes
+}
+
+func poolSpecFromModel(m *kernelmodel.Model, role string, replicas int, fallbackEC engineConfig) (sim.PoolConfig, *sim.ModelRooflineSpec) {
+	gpuType := fallbackEC.GPU
+	if gpuType == "" {
+		gpuType = gpu
+	}
+	if gpuType == "" {
+		gpuType = "unknown"
+	}
+	tp := max(fallbackEC.TP, 1)
+	pp := 1
+	dp := max(dataParallelism, 1)
+	gpusPerPod := tp * pp * dp
+	kvBlockSize := max(int(fallbackEC.BlockSizeTokens), 16)
+	kvBlocksPerGPU := max(fallbackEC.TotalKVBlocks, 1)
+	maxSeqs := max(int(fallbackEC.MaxNumSeqs), 1)
+	maxBatched := max(int(fallbackEC.MaxNumBatchedTokens), 1)
+	maxLen := max(int(fallbackEC.MaxModelLen), 2048)
+
+	gpuSpecs := sim.GPUSpecs{
+		MemoryGiB:  80,
+		TFLOPsPeak: 100,
+		TFLOPsFP8:  0,
+		BWPeakTBs:  1.0,
+		SMCount:    1,
+	}
+	var memBreakdown sim.MemoryBreakdownBytes
+	var spec *sim.ModelRooflineSpec
+
+	if m != nil {
+		dep := m.Deployment()
+		if dep.Hardware != "" {
+			gpuType = dep.Hardware
+		}
+		kvBlockSize = max(int(dep.BlockSize), kvBlockSize)
+		k := m.Kernel()
+		res := k.Resolved()
+		tp = max(res.TensorParallel(), 1)
+		pp = max(k.Deployment().Parallel.PP, 1)
+		dp = max(res.DataParallel(), 1)
+		gpusPerPod = max(m.GroupGPUs(), tp*pp*dp)
+
+		fb := k.FixedBytes()
+		memBreakdown = sim.MemoryBreakdownBytes{
+			Weights:        max(fb.Weights+fb.EPLBRedundant, 0),
+			ActivationPeak: max(fb.ActivationPeak, 0),
+			CUDAGraph:      max(fb.CUDAGraph, 0),
+			CommBuffers:    max(fb.CommBuffers, 0),
+		}
+
+		if s, err := m.SettingsReserving(loraReservedBytesForKV); err == nil {
+			kvBlocksPerGPU = max(s.KVBlocks, kvBlocksPerGPU)
+			kvBlockSize = max(s.BlockSize, kvBlockSize)
+			maxSeqs = max(s.MaxNumSeqs, 1)
+			maxBatched = max(s.MaxNumBatchedTokens, 1)
+			maxLen = max(s.MaxModelLen, 1)
+		} else if b, bErr := m.KVBudget(); bErr == nil {
+			kvBlocksPerGPU = max(b.PerRankBlocks, kvBlocksPerGPU)
+		}
+
+		var chip *hardware.Chip
+		if dep.Hardware != "" {
+			if c, err := mustRunData().Chip(dep.Hardware); err == nil && c != nil {
+				chip = c
+				if c.MemoryGiB > 0 {
+					gpuSpecs.MemoryGiB = c.MemoryGiB
+				}
+				if c.BF16Peak > 0 {
+					gpuSpecs.TFLOPsPeak = c.BF16Peak
+				}
+				if c.FP8Peak >= 0 {
+					gpuSpecs.TFLOPsFP8 = c.FP8Peak
+				}
+				if c.MemoryBandwidthTBs > 0 {
+					gpuSpecs.BWPeakTBs = c.MemoryBandwidthTBs
+				}
+				if c.SMCount >= 1 {
+					gpuSpecs.SMCount = c.SMCount
+				}
+			}
+		} else if dep.DeviceMemoryGiB > 0 {
+			gpuSpecs.MemoryGiB = dep.DeviceMemoryGiB
+		}
+
+		var g *specmodel.Graph
+		if dep.Model != "" {
+			if loadedGraph, err := mustRunData().Model(dep.Model); err == nil {
+				g = loadedGraph
+			}
+		}
+		spec = rooflineSpecFromKernel(dep, k, fb, g, chip, gpuSpecs, kvBlockSize, tp, pp)
+	}
+
+	poolCfg := sim.PoolConfig{
+		Role:                 role,
+		Replicas:             max(replicas, 0),
+		TP:                   tp,
+		PP:                   pp,
+		DP:                   dp,
+		GPUsPerPod:           max(gpusPerPod, 1),
+		GPUType:              gpuType,
+		GPUSpecs:             gpuSpecs,
+		MemoryBreakdownBytes: memBreakdown,
+		KVBlocksPerGPU:       max(kvBlocksPerGPU, 1),
+		KVBlockSizeTokens:    max(kvBlockSize, 1),
+		MaxNumSeqs:           max(maxSeqs, 1),
+		MaxNumBatchedTokens:  max(maxBatched, 1),
+		MaxModelLen:          max(maxLen, 1),
+	}
+	return poolCfg, spec
+}
+
+func rooflineSpecFromKernel(dep kernelmodel.Deployment, k kernel.Kernel, fb kernel.MemoryBreakdown, g *specmodel.Graph, chip *hardware.Chip, gpuSpecs sim.GPUSpecs, kvBlockSize, tp, pp int) *sim.ModelRooflineSpec {
+	spec := &sim.ModelRooflineSpec{
+		ModelName:           dep.Model,
+		IsMoE:               dep.MoE,
+		NumExperts:          int64(dep.Experts),
+		ExpertsPerTok:       int64(dep.ExpertsPerTok),
+		WeightBytesPerRank:  fb.Weights,
+		ActivationPeakBytes: fb.ActivationPeak,
+		TP:                  max(tp, 1),
+		PP:                  max(pp, 1),
+		ChipTFLOPsPeak:      gpuSpecs.TFLOPsPeak,
+		ChipTFLOPsFP8:       gpuSpecs.TFLOPsFP8,
+		ChipBWTBs:           gpuSpecs.BWPeakTBs,
+	}
+	if chip != nil {
+		if chip.BF16Peak > 0 {
+			spec.ChipTFLOPsPeak = chip.BF16Peak
+		}
+		if chip.FP8Peak > 0 {
+			spec.ChipTFLOPsFP8 = chip.FP8Peak
+		}
+		if chip.MemoryBandwidthTBs > 0 {
+			spec.ChipBWTBs = chip.MemoryBandwidthTBs
+		}
+	}
+	if kvPerTok := k.SequenceVariableBytes(1); kvPerTok > 0 {
+		spec.KVBytesPerTokenPerRank = kvPerTok
+	} else if kvBlockSize > 0 {
+		if kvPerBlock := k.SequenceVariableBytes(kvBlockSize); kvPerBlock > 0 {
+			spec.KVBytesPerTokenPerRank = kvPerBlock / int64(kvBlockSize)
+		}
+	}
+	if g != nil {
+		spec.HiddenSize = int64(g.Global.HiddenSize)
+		spec.VocabSize = int64(g.Global.VocabSize)
+		spec.NumHiddenLayers = int64(g.Stack.Layers())
+		for _, lk := range g.LayerKinds {
+			for _, n := range lk.Nodes {
+				if n.Op == specmodel.OpAttention {
+					if spec.NumAttentionHeads == 0 || n.ReadsEngineKV() {
+						if n.NumQHeads > 0 {
+							spec.NumAttentionHeads = int64(n.NumQHeads)
+						}
+						if n.NumKVHeads > 0 {
+							spec.NumKVHeads = int64(n.NumKVHeads)
+						}
+						if n.HeadDim > 0 {
+							spec.HeadDim = int64(n.HeadDim)
+						}
+					}
+				}
+				if (n.Op == specmodel.OpGEMM || n.Op == specmodel.OpGroupedGEMM) && n.K == g.Global.HiddenSize && int64(n.N) > spec.IntermediateSize {
+					spec.IntermediateSize = int64(n.N)
+				}
+			}
+		}
+		if spec.IntermediateSize == 0 {
+			for _, lk := range g.LayerKinds {
+				for _, n := range lk.Nodes {
+					if (n.Op == specmodel.OpGEMM || n.Op == specmodel.OpGroupedGEMM) && int64(n.N) > spec.IntermediateSize {
+						spec.IntermediateSize = int64(n.N)
+					}
+				}
+			}
+		}
+		if spec.HeadDim == 0 && spec.HiddenSize > 0 && spec.NumAttentionHeads > 0 {
+			spec.HeadDim = spec.HiddenSize / spec.NumAttentionHeads
+		}
+		spec.IsFP8 = strings.Contains(strings.ToLower(dep.Quantization), "fp8") || g.Global.WeightDType == specmodel.DTypeFP8
+	} else {
+		spec.IsFP8 = strings.Contains(strings.ToLower(dep.Quantization), "fp8")
+	}
+	if spec.IsFP8 && spec.ChipTFLOPsFP8 > 0 {
+		spec.ComputePeakTFLOPs = spec.ChipTFLOPsFP8
+	} else {
+		spec.ComputePeakTFLOPs = spec.ChipTFLOPsPeak
+	}
+	return spec
+}
