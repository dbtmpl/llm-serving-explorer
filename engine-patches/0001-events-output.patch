+// TestEventsOutput_ParityDeterminismAndInvariants verifies INV-6 zero behavioral perturbation
+// (identical normalized Result JSON with vs without --events-output), byte-identical NDJSON
+// outputs across repeated runs, and monotonic seq/t_us + final metrics.snapshot invariants.
+func TestEventsOutput_ParityDeterminismAndInvariants(t *testing.T) {
+	t.Parallel()
+
+	type testCase struct {
+		name           string
+		buildArgs      func(t *testing.T) []string
+		wantEventTypes []string
+	}
+
+	cases := []testCase{
+		{
+			name: "colocated llama-3.1-8b-instruct on a100-sxm",
+			buildArgs: func(t *testing.T) []string {
+				dir := t.TempDir()
+				if err := os.WriteFile(filepath.Join(dir, "llama-8b-a100.yaml"), []byte(llama8bA100ColocatedScenario), 0o644); err != nil {
+					t.Fatal(err)
+				}
+				return []string{
+					"run",
+					"--scenarios", dir,
+					"--scenario", "llama-8b-a100.yaml",
+					"--num-requests", "10",
+					"--rate", "5",
+					"--seed", "42",
+				}
+			},
+			wantEventTypes: []string{
+				sim.EventTypePodCreated,
+				sim.EventTypePodReady,
+				sim.EventTypeRequestArrived,
+				sim.EventTypeRequestFinished,
+				sim.EventTypeBatchStep,
+				sim.EventTypeMetricsSnapshot,
+			},
+		},
+		{
+			name: "cpu-offloaded llama-3.1-8b-instruct on a100-sxm",
+			buildArgs: func(t *testing.T) []string {
+				dir := t.TempDir()
+				if err := os.WriteFile(filepath.Join(dir, "llama-8b-a100-offload.yaml"), []byte(llama8bA100OffloadScenario), 0o644); err != nil {
+					t.Fatal(err)
+				}
+				return []string{
+					"run",
+					"--scenarios", dir,
+					"--scenario", "llama-8b-a100-offload.yaml",
+					"--num-requests", "15",
+					"--rate", "10",
+					"--prompt-tokens", "2048",
+					"--output-tokens", "128",
+					"--seed", "42",
+				}
+			},
+			wantEventTypes: []string{
+				sim.EventTypeKVBlockMoved,
+				sim.EventTypeKVBlockEvicted,
+				sim.EventTypeMetricsSnapshot,
+			},
+		},
+		{
+			name: "disaggregated 3p1d",
+			buildArgs: func(t *testing.T) []string {
+				return []string{
+					"run",
+					"--scenarios", pdScenarios,
+					"--scenario", "glm-5-h200-3p1d-ib.yaml",
+					"--num-instances", "4",
+					"--prefill-instances", "3",
+					"--decode-instances", "1",
+					"--num-requests", "8",
+					"--rate", "5",
+					"--seed", "11",
+					"--horizon", "900000000",
+				}
+			},
+			wantEventTypes: []string{
+				sim.EventTypeKVTransfer,
+				sim.EventTypeMetricsSnapshot,
+			},
+		},
+		{
+			name: "autoscaling lifecycle",
+			buildArgs: func(t *testing.T) []string {
+				dir := t.TempDir()
+				if err := os.WriteFile(filepath.Join(dir, "llama-8b-a100.yaml"), []byte(llama8bA100ColocatedScenario), 0o644); err != nil {
+					t.Fatal(err)
+				}
+				policyPath := capFile(t, "autoscale-policy.yaml", llama8bAutoscalePolicy)
+				workloadPath := capFile(t, "autoscale-workload.yaml", llama8bAutoscaleWorkload)
+				return []string{
+					"run",
+					"--scenarios", dir,
+					"--scenario", "llama-8b-a100.yaml",
+					"--num-instances", "1",
+					"--policy-config", policyPath,
+					"--model-autoscaler-interval-us", "1000000",
+					"--workload-spec", workloadPath,
+					"--horizon", "35000000",
+					"--seed", "42",
+				}
+			},
+			wantEventTypes: []string{
+				sim.EventTypePodCreated,
+				sim.EventTypePodLoading,
+				sim.EventTypePodReady,
+				sim.EventTypePodDraining,
+				sim.EventTypePodTerminated,
+				sim.EventTypeMetricsSnapshot,
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			baseArgs := tc.buildArgs(t)
+
+			withoutOut, stderr, err := runKernelCLI(t, baseArgs...)
+			if err != nil {
+				t.Fatalf("run without --events-output: %v\n%s", err, lastLines(stderr, 8))
+			}
+			if !completedAny(withoutOut) {
+				t.Fatalf("non-vacuity: simulation completed 0 requests:\n%s", withoutOut)
+			}
+
+			evPath1 := filepath.Join(t.TempDir(), "events1.ndjson")
+			args1 := append(append([]string(nil), baseArgs...), "--events-output", evPath1)
+			withOut1, stderr, err := runKernelCLI(t, args1...)
+			if err != nil {
+				t.Fatalf("run #1 with --events-output: %v\n%s", err, lastLines(stderr, 8))
+			}
+
+			evPath2 := filepath.Join(t.TempDir(), "events2.ndjson")
+			args2 := append(append([]string(nil), baseArgs...), "--events-output", evPath2)
+			withOut2, stderr, err := runKernelCLI(t, args2...)
+			if err != nil {
+				t.Fatalf("run #2 with --events-output: %v\n%s", err, lastLines(stderr, 8))
+			}
+
+			normWithout := withoutRuntime(t, withoutOut)
+			normWith1 := withoutRuntime(t, withOut1)
+			normWith2 := withoutRuntime(t, withOut2)
+			if normWithout != normWith1 {
+				t.Fatalf("Result JSON changed when --events-output was enabled:\n%s", firstDiff(normWithout, normWith1))
+			}
+			if normWith1 != normWith2 {
+				t.Fatalf("Result JSON differed between repeated --events-output runs:\n%s", firstDiff(normWith1, normWith2))
+			}
+
+			ndjson1, err := os.ReadFile(evPath1)
+			if err != nil {
+				t.Fatalf("read events1: %v", err)
+			}
+			ndjson2, err := os.ReadFile(evPath2)
+			if err != nil {
+				t.Fatalf("read events2: %v", err)
+			}
+			if !bytes.Equal(ndjson1, ndjson2) {
+				t.Fatalf("repeated --events-output runs were not byte-identical (%d vs %d bytes):\n%s",
+					len(ndjson1), len(ndjson2), firstDiff(string(ndjson1), string(ndjson2)))
+			}
+
+			counts := assertEventsStreamInvariants(t, ndjson1)
+			for _, want := range tc.wantEventTypes {
+				if counts[want] == 0 {
+					t.Errorf("expected event type %q in stream, got counts=%v", want, counts)
+				}
+			}
+			if !strings.Contains(string(ndjson1), `"is_final":true`) {
+				t.Errorf("expected final snapshot marker in NDJSON stream")
+			}
+		})
+	}
+}
