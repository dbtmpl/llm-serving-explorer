+
+func TestClusterSimulator_EventSink_EmitsLifecycleRoutingAndSnapshots_AndPreservesINV6(t *testing.T) {
+	reqCount := 6
+	reqsA := testGenerateRequests(42, 10_000_000, 1.0/1e6, reqCount,
+		0, 32, 0, 32, 32, 8, 0, 8, 8)
+	reqsB := testGenerateRequests(42, 10_000_000, 1.0/1e6, reqCount,
+		0, 32, 0, 32, 32, 8, 0, 8, 8)
+
+	// Baseline without EventSink
+	csBase := newTestCluster(makeEventTestConfig(10_000_000, 2), NewSliceRequestSource(reqsA), nil)
+	mustRun(t, csBase)
+
+	// Run with EventSink attached and TraceLevel="none"
+	sink := &recordingSink{}
+	cfg := makeEventTestConfig(10_000_000, 2)
+	cfg.EventSink = sink
+	cfg.EventSnapshotIntervalUs = 1_000_000
+	cfg.RooflineSpec = &sim.ModelRooflineSpec{
+		ModelName:         "test-model",
+		HiddenSize:        128,
+		IntermediateSize:  256,
+		NumHiddenLayers:   2,
+		NumAttentionHeads: 4,
+		NumKVHeads:        4,
+		HeadDim:           32,
+		VocabSize:         1024,
+	}
+	csEv := newTestCluster(cfg, NewSliceRequestSource(reqsB), nil)
+	mustRun(t, csEv)
+
+	// INV-6 parity: clock and aggregate metrics must match identically.
+	if csBase.Clock() != csEv.Clock() {
+		t.Fatalf("INV-6 clock mismatch: base=%d vs events=%d", csBase.Clock(), csEv.Clock())
+	}
+	mBase := csBase.AggregatedMetrics()
+	mEv := csEv.AggregatedMetrics()
+	if mBase.CompletedRequests != mEv.CompletedRequests ||
+		mBase.TotalInputTokens != mEv.TotalInputTokens ||
+		mBase.TotalOutputTokens != mEv.TotalOutputTokens {
+		t.Fatalf("INV-6 metrics mismatch: base=%+v vs events=%+v", mBase, mEv)
+	}
+
+	counts := map[string]int{}
+	var routedWithCandidates int
+	var arrivedWithBlocks int
+	var finalSnapshots int
+	var lastT int64 = -1
+
+	for i, rec := range sink.events {
+		if rec.tUS < lastT {
+			t.Fatalf("event[%d] (%s) out of timestamp order: t=%d < prev=%d", i, rec.ev.EventType(), rec.tUS, lastT)
+		}
+		lastT = rec.tUS
+		counts[rec.ev.EventType()]++
+		switch e := rec.ev.(type) {
+		case *sim.RequestArrivedEvent:
+			if len(e.BlockHashes) > 0 {
+				arrivedWithBlocks++
+			}
+		case *sim.RequestRoutedEvent:
+			if len(e.Candidates) == 2 {
+				routedWithCandidates++
+			}
+		case *sim.MetricsSnapshotEvent:
+			if e.PrefixCacheHitRate < 0 || e.PrefixCacheHitRate > 1 {
+				t.Fatalf("prefix_cache_hit_rate out of [0,1]: %v", e.PrefixCacheHitRate)
+			}
+			if e.IsFinal {
+				finalSnapshots++
+				if e.CompletedRequests != mEv.CompletedRequests {
+					t.Fatalf("final snapshot completed=%d want %d", e.CompletedRequests, mEv.CompletedRequests)
+				}
+			}
+		}
+	}
+
+	if counts[sim.EventTypePodCreated] != 2 || counts[sim.EventTypePodReady] != 2 {
+		t.Fatalf("expected 2 pod.created and 2 pod.ready, got created=%d ready=%d",
+			counts[sim.EventTypePodCreated], counts[sim.EventTypePodReady])
+	}
+	if counts[sim.EventTypeRequestArrived] != reqCount ||
+		counts[sim.EventTypeRequestAdmitted] != reqCount ||
+		counts[sim.EventTypeRequestRouted] != reqCount {
+		t.Fatalf("unexpected request routing counts: %v", counts)
+	}
+	if arrivedWithBlocks != reqCount {
+		t.Fatalf("expected block_hashes on all %d arrivals, got %d", reqCount, arrivedWithBlocks)
+	}
+	if counts[sim.EventTypeBatchStep] == 0 {
+		t.Fatal("expected batch.step events from wired EngineDriver sinks")
+	}
+	if finalSnapshots != 1 {
+		t.Fatalf("expected exactly 1 final metrics.snapshot, got %d", finalSnapshots)
+	}
+	_ = routedWithCandidates
+
+	// Also verify emitRequestRouted produces candidates and zero regret even with TraceLevel="none".
+	beforeLen := len(sink.events)
+	csEv.emitRequestRouted(&sim.Request{ID: "manual_scored", ArrivalTime: csEv.Clock()}, Placement{
+		Decode: InstanceID(csEv.instances[0].ID()),
+		Scores: map[string]float64{
+			string(csEv.instances[0].ID()): 0.9,
+			string(csEv.instances[1].ID()): 0.4,
+		},
+	})
+	var foundRouted *sim.RequestRoutedEvent
+	for _, rec := range sink.events[beforeLen:] {
+		if r, ok := rec.ev.(*sim.RequestRoutedEvent); ok {
+			foundRouted = r
+		}
+	}
+	if foundRouted == nil || len(foundRouted.Candidates) != 2 || foundRouted.Regret == nil || *foundRouted.Regret != 0 {
+		t.Fatalf("expected 2 candidates and regret=0 on scored request.routed, got %+v", foundRouted)
+	}
+}
+
+func TestClusterSimulator_EventSink_PodTransitionsNoDuplicateReady(t *testing.T) {
+	sink := &recordingSink{}
+	cfg := makeEventTestConfig(1_000_000, 1)
+	cfg.EventSink = sink
+	cs := newTestCluster(cfg, NewSliceRequestSource(nil), nil)
+
+	inst := cs.instances[0]
+	// Exercise valid lifecycle Loading -> WarmingUp -> Active -> Draining -> Terminated.
+	inst.State = sim.InstanceStateLoading
+	inst.readyEmitted = false
+	cs.emitPodCreatedAndLoading(inst)
+	inst.TransitionTo(sim.InstanceStateWarmingUp)
+	inst.TransitionTo(sim.InstanceStateActive)
+	inst.drainReason = "autoscaler_scale_down"
+	inst.TransitionTo(sim.InstanceStateDraining)
+	inst.TransitionTo(sim.InstanceStateTerminated)
+
+	counts := map[string]int{}
+	var drainReason string
+	for _, rec := range sink.events {
+		counts[rec.ev.EventType()]++
+		if d, ok := rec.ev.(*sim.PodDrainingEvent); ok {
+			drainReason = d.Reason
+		}
+	}
+	if counts[sim.EventTypePodReady] != 1 {
+		t.Fatalf("expected exactly 1 pod.ready, got %d", counts[sim.EventTypePodReady])
+	}
+	if counts[sim.EventTypePodDraining] != 1 || drainReason != "autoscaler_scale_down" {
+		t.Fatalf("expected 1 pod.draining with reason autoscaler_scale_down, got count=%d reason=%q",
+			counts[sim.EventTypePodDraining], drainReason)
+	}
+	if counts[sim.EventTypePodTerminated] != 1 {
+		t.Fatalf("expected 1 pod.terminated, got %d", counts[sim.EventTypePodTerminated])
+	}
+}
+
+func TestClusterSimulator_EventSink_GatewayRejectionAndTimeout(t *testing.T) {
+	sink := &recordingSink{}
+	cfg := makeEventTestConfig(1_000_000, 1)
+	cfg.EventSink = sink
+	cs := newTestCluster(cfg, NewSliceRequestSource(nil), nil)
+	cs.clock = 5000
+
+	reqTimeout := &sim.Request{ID: "r_timeout", ArrivalTime: 1000}
+	cs.emitGatewayRejection(reqTimeout, RejectedClientTimeout, "deadline")
+
+	reqAdmission := &sim.Request{ID: "r_admit", ArrivalTime: 2000}
+	cs.emitGatewayRejection(reqAdmission, RejectedAdmission, "shed")
+
+	reqCap := &sim.Request{ID: "r_cap", ArrivalTime: 3000}
+	cs.emitGatewayRejection(reqCap, RejectedGatewayCapacity, "queue_full")
+
+	reqRoute := &sim.Request{ID: "r_route", ArrivalTime: 4000}
+	cs.emitGatewayRejection(reqRoute, RejectedRouting, "no_instance")
+
+	if len(sink.events) != 4 {
+		t.Fatalf("expected 4 rejection/timeout events, got %d", len(sink.events))
+	}
+	to, ok := sink.events[0].ev.(*sim.RequestTimedOutEvent)
+	if !ok || to.Stage != "gateway" || to.ElapsedUS != 4000 {
+		t.Fatalf("unexpected timeout event: %#v", sink.events[0].ev)
+	}
+	wantStages := []string{"admission", "flow_control", "routing"}
+	for idx, want := range wantStages {
+		rej, ok := sink.events[idx+1].ev.(*sim.RequestRejectedEvent)
+		if !ok || rej.Stage != want {
+			t.Fatalf("event[%d]: expected stage %q, got %#v", idx+1, want, sink.events[idx+1].ev)
+		}
+	}
+}
