+	header *sim.HeaderRecord
+	events []recordedEvent
+	seq    uint64
+}
+
+func (s *recordingSink) Enabled() bool { return true }
+
+func (s *recordingSink) WriteHeader(h *sim.HeaderRecord) error {
+	s.header = h
