+func TestEngineDriver_EventSink_LifecycleAndINV6(t *testing.T) {
+	for _, applyAtStart := range []bool{false, true} {
+		name := "applyAtEnd"
+		if applyAtStart {
+			name = "applyAtStart"
+		}
+		t.Run(name, func(t *testing.T) {
+			runDriver := func(sink EventSink) (*EngineDriver, []*Request) {
+				eng, err := enginetest.NewFIFO(enginetest.FIFOConfig{
+					MaxRunning:     4,
+					TokenBudget:    8, // Forces chunked prefill on 16-token prompt
+					StepBaseUs:     100,
+					StepPerTokenUs: 10,
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				cfg := EngineDriverConfig{
+					Horizon:          1 << 40,
+					ApplyAtStepStart: applyAtStart,
+					EventSink:        sink,
+					PodID:            "pod-test",
+					TPDegree:         2,
+					KVBlockSize:      8,
+					KVBlocksTotal:    64,
+					RooflineSpec: &ModelRooflineSpec{
+						HiddenSize:             512,
+						IntermediateSize:       1024,
+						NumHiddenLayers:        4,
+						NumAttentionHeads:      8,
+						NumKVHeads:             4,
+						HeadDim:                64,
+						VocabSize:              1000,
+						WeightBytesPerRank:     1_000_000,
+						KVBytesPerTokenPerRank: 1024,
+						TP:                     2,
+						PP:                     1,
+						ChipTFLOPsPeak:         100,
+						ChipBWTBs:              1.0,
+					},
+				}
+				d := NewEngineDriver(eng, cfg)
+				r0 := &Request{ID: "r0", InputTokens: tokens(16), OutputTokens: tokens(3), ArrivalTime: 0}
+				// r1 arrives mid-first-step to exercise ApplyAtStepStart timestamp ordering!
+				r1 := &Request{ID: "r1", InputTokens: tokens(8), OutputTokens: tokens(2), ArrivalTime: 50}
+				d.InjectArrival(r0)
+				d.InjectArrival(r1)
+				d.Run()
+				return d, []*Request{r0, r1}
+			}
+
+			baseDriver, baseReqs := runDriver(nil)
+			var buf bytes.Buffer
+			sink := NewJSONLEventSink(&buf)
+			obsDriver, obsReqs := runDriver(sink)
+			if err := sink.Close(); err != nil {
+				t.Fatal(err)
+			}
+
+			// INV-6: Metrics and per-request outcomes must be identical.
+			if baseDriver.Metrics.CompletedRequests != obsDriver.Metrics.CompletedRequests ||
+				baseDriver.Metrics.TotalInputTokens != obsDriver.Metrics.TotalInputTokens ||
+				baseDriver.Metrics.TotalOutputTokens != obsDriver.Metrics.TotalOutputTokens ||
+				baseDriver.Metrics.SimEndedTime != obsDriver.Metrics.SimEndedTime ||
+				!reflect.DeepEqual(baseDriver.Metrics.RequestTTFTs, obsDriver.Metrics.RequestTTFTs) ||
+				!reflect.DeepEqual(baseDriver.Metrics.RequestE2Es, obsDriver.Metrics.RequestE2Es) ||
+				!reflect.DeepEqual(baseDriver.Metrics.RequestITLs, obsDriver.Metrics.RequestITLs) ||
+				!reflect.DeepEqual(baseDriver.Metrics.RequestSchedulingDelays, obsDriver.Metrics.RequestSchedulingDelays) ||
+				!reflect.DeepEqual(baseDriver.Metrics.AllITLs, obsDriver.Metrics.AllITLs) {
+				t.Fatalf("INV-6 violated when EventSink enabled:\nbase=%+v\nobs=%+v", baseDriver.Metrics, obsDriver.Metrics)
+			}
+			for i := range baseReqs {
+				if baseReqs[i].FirstTokenTime != obsReqs[i].FirstTokenTime ||
+					!reflect.DeepEqual(baseReqs[i].ITL, obsReqs[i].ITL) {
+					t.Fatalf("request %d mismatch under EventSink", i)
+				}
+			}
+
+			recs := parseNDJSONLines(t, buf.Bytes())
+			if len(recs) == 0 {
+				t.Fatal("expected emitted events")
+			}
+
+			seenTypes := map[string]int{}
+			var prevT float64
+			for i, rec := range recs {
+				if rec["seq"] != float64(i) {
+					t.Errorf("seq[%d] = %v, want %d", i, rec["seq"], i)
+				}
+				tUS := rec["t_us"].(float64)
+				if i > 0 && tUS < prevT {
+					t.Errorf("non-monotonic t_us at seq %d: %v < %v", i, tUS, prevT)
+				}
+				prevT = tUS
+				typ := rec["type"].(string)
+				seenTypes[typ]++
+
+				if typ == EventTypeKVBlockAllocated {
+					gpuIdx := rec["gpu_indices"].([]any)
+					if len(gpuIdx) != 2 {
+						t.Errorf("gpu_indices len = %d, want 2", len(gpuIdx))
+					}
+					bids := rec["block_ids"].([]any)
+					if len(bids) == 0 {
+						t.Errorf("kv.block.allocated block_ids empty")
+					}
+				}
+			}
+
+			for _, reqType := range []string{
+				EventTypeRequestQueued,
+				EventTypeRequestScheduled,
+				EventTypeRequestPrefill,
+				EventTypeRequestDecode,
+				EventTypeRequestFinished,
+				EventTypeBatchStep,
+				EventTypeKVBlockAllocated,
+			} {
+				if seenTypes[reqType] == 0 {
+					t.Errorf("expected at least one %s event, got 0 (seen=%v)", reqType, seenTypes)
+				}
+			}
+		})
+	}
+}
