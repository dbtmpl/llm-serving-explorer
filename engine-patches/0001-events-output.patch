index 00000000..c9fe99f1
--- /dev/null
+++ b/sim/events_schema.go
@@ -0,0 +1,511 @@
+package sim
+
+// SchemaVersionV1 is the NDJSON event stream schema version matching schema/events.schema.json.
+const SchemaVersionV1 = "1.0"
+
+// Event type constants matching schema/events.schema.json.
+const (
+	EventTypeHeader           = "header"
+	EventTypeRequestArrived   = "request.arrived"
+	EventTypeRequestAdmitted  = "request.admitted"
+	EventTypeRequestRejected  = "request.rejected"
+	EventTypeRequestRouted    = "request.routed"
+	EventTypeRequestQueued    = "request.queued"
+	EventTypeRequestScheduled = "request.scheduled"
+	EventTypeRequestPrefill   = "request.prefill"
+	EventTypeRequestDecode    = "request.decode_step"
+	EventTypeRequestPreempted = "request.preempted"
+	EventTypeRequestFinished  = "request.finished"
+	EventTypeRequestTimedOut  = "request.timed_out"
+	EventTypeBatchStep        = "batch.step"
+	EventTypeKVBlockAllocated = "kv.block.allocated"
+	EventTypeKVBlockCached    = "kv.block.cached"
+	EventTypeKVBlockEvicted   = "kv.block.evicted"
+	EventTypeKVBlockMoved     = "kv.block.moved"
+	EventTypeKVTransfer       = "kv.transfer"
+	EventTypePodCreated       = "pod.created"
+	EventTypePodLoading       = "pod.loading"
+	EventTypePodReady         = "pod.ready"
+	EventTypePodDraining      = "pod.draining"
+	EventTypePodTerminated    = "pod.terminated"
+	EventTypeMetricsSnapshot  = "metrics.snapshot"
+)
+
+// EventBase holds the common required fields on every v1 event record.
+type EventBase struct {
+	Seq  uint64 `json:"seq"`
+	TUs  int64  `json:"t_us"`
+	Type string `json:"type"`
+}
+
+// SetHeader stamps the monotonically increasing sequence number, timestamp, and type.
+func (b *EventBase) SetHeader(seq uint64, tUS int64, eventType string) {
+	b.Seq = seq
+	b.TUs = tUS
+	if b.Type == "" {
+		b.Type = eventType
+	}
+}
+
+// EventRecord is implemented by every typed v1 event emitted through EventSink.
+type EventRecord interface {
+	EventType() string
+	SetHeader(seq uint64, tUS int64, eventType string)
+}
+
+// GPUSpecs captures per-GPU hardware capabilities for the header topology.
+type GPUSpecs struct {
+	MemoryGiB  float64 `json:"memory_gib"`
+	TFLOPsPeak float64 `json:"tflops_peak"`
+	TFLOPsFP8  float64 `json:"tflops_fp8"`
+	BWPeakTBs  float64 `json:"bw_peak_tbs"`
+	SMCount    int     `json:"sm_count"`
+}
+
+// MemoryBreakdownBytes captures static per-GPU memory reservations in bytes.
+type MemoryBreakdownBytes struct {
+	Weights        int64 `json:"weights"`
+	ActivationPeak int64 `json:"activation_peak"`
+	CUDAGraph      int64 `json:"cuda_graph"`
+	CommBuffers    int64 `json:"comm_buffers"`
+}
+
+// PoolConfig describes one serving pool in HeaderTopology.
+type PoolConfig struct {
+	Role                 string               `json:"role"`
+	Replicas             int                  `json:"replicas"`
+	TP                   int                  `json:"tp"`
+	PP                   int                  `json:"pp"`
+	DP                   int                  `json:"dp"`
+	GPUsPerPod           int                  `json:"gpus_per_pod"`
+	GPUType              string               `json:"gpu_type"`
+	GPUSpecs             GPUSpecs             `json:"gpu_specs"`
+	MemoryBreakdownBytes MemoryBreakdownBytes `json:"memory_breakdown_bytes"`
+	KVBlocksPerGPU       int64                `json:"kv_blocks_per_gpu"`
+	KVBlockSizeTokens    int                  `json:"kv_block_size_tokens"`
+	MaxNumSeqs           int                  `json:"max_num_seqs"`
+	MaxNumBatchedTokens  int                  `json:"max_num_batched_tokens"`
+	MaxModelLen          int                  `json:"max_model_len"`
+}
+
+// InitialPod describes a pod present at simulation start in HeaderTopology.
+type InitialPod struct {
+	PodID    string   `json:"pod_id"`
+	PoolRole string   `json:"pool_role"`
+	GPUIDs   []string `json:"gpu_ids"`
+	TPDegree int      `json:"tp_degree"`
+	State    string   `json:"state"`
+}
+
+// HeaderBLIS identifies the simulator and stack versions in HeaderRecord.
+type HeaderBLIS struct {
+	Commit        string            `json:"commit"`
+	VLLMVersion   string            `json:"vllm_version"`
+	LLMDVersion   string            `json:"llmd_version"`
+	StackVersions map[string]string `json:"stack_versions"`
+}
+
+// HeaderScenario identifies the run configuration in HeaderRecord.
+type HeaderScenario struct {
+	Name          string         `json:"name"`
+	Model         string         `json:"model"`
+	Hardware      string         `json:"hardware"`
+	Flags         map[string]any `json:"flags"`
+	Seed          int64          `json:"seed"`
+	HorizonUS     int64          `json:"horizon_us"`
+	RoutingPolicy string         `json:"routing_policy,omitempty"`
+}
+
+// HeaderTiers describes KV cache tiers modelled in the simulation.
+type HeaderTiers struct {
+	GPUHBMBlocks        int64             `json:"gpu_hbm_blocks"`
+	CPURAMBlocks        int64             `json:"cpu_ram_blocks"`
+	CPURAMBytes         int64             `json:"cpu_ram_bytes"`
+	LocalSSDModelled    bool              `json:"local_ssd_modelled"`
+	RemoteStoreModelled bool              `json:"remote_store_modelled"`
+	UnmodelledNotes     map[string]string `json:"unmodelled_notes"`
+}
+
+// HeaderTopology describes the cluster topology at simulation start.
+type HeaderTopology struct {
+	GatewayLatencyUS int64        `json:"gateway_latency_us"`
+	Pools            []PoolConfig `json:"pools"`
+	Tiers            HeaderTiers  `json:"tiers"`
+	InitialPods      []InitialPod `json:"initial_pods"`
+}
+
+// HeaderRecord is the first line of a v1 NDJSON event stream.
+type HeaderRecord struct {
+	Type          string         `json:"type"`
+	SchemaVersion string         `json:"schema_version"`
+	BLIS          HeaderBLIS     `json:"blis"`
+	Scenario      HeaderScenario `json:"scenario"`
+	Topology      HeaderTopology `json:"topology"`
+}
+
+// RequestArrivedEvent records a request entering the system.
+type RequestArrivedEvent struct {
+	EventBase
+	ReqID           string   `json:"req_id"`
+	PromptTokens    int      `json:"prompt_tokens"`
+	MaxOutputTokens int      `json:"max_output_tokens"`
+	PrefixGroup     string   `json:"prefix_group,omitempty"`
+	PrefixTokens    int      `json:"prefix_tokens,omitempty"`
+	BlockHashes     []string `json:"block_hashes,omitempty"`
+	SLOClass        string   `json:"slo_class,omitempty"`
+	SessionID       string   `json:"session_id,omitempty"`
+}
+
+// EventType returns the schema event type identifier.
+func (*RequestArrivedEvent) EventType() string { return EventTypeRequestArrived }
+
+// RequestAdmittedEvent records gateway admission of a request.
+type RequestAdmittedEvent struct {
+	EventBase
+	ReqID  string `json:"req_id"`
+	Reason string `json:"reason,omitempty"`
+}
+
+// EventType returns the schema event type identifier.
+func (*RequestAdmittedEvent) EventType() string { return EventTypeRequestAdmitted }
+
+// RequestRejectedEvent records rejection of a request at admission, routing, or engine enqueue.
+type RequestRejectedEvent struct {
+	EventBase
+	ReqID  string `json:"req_id"`
+	Reason string `json:"reason"`
+	Stage  string `json:"stage"`
+}
+
+// EventType returns the schema event type identifier.
