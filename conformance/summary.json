  "notVerifiable": [
    {
      "approach": "admission/prompt",
      "reason": "vLLM allocates KV memory as tokens are written and BLIS translates vLLM, so neither has a policy that reserves a whole prompt before admitting it; there is no counterpart to compare."
    },
    {
      "approach": "admission/reserve",
      "reason": "vLLM does not reserve KV memory for a request's whole output at admission, and BLIS follows vLLM, so there is no counterpart to compare."
    },
    {
      "approach": "batching/static",
      "reason": "vLLM does no static batching (it schedules continuously) and BLIS translates vLLM, so there is no counterpart to compare."
    },
    {
      "approach": "kvcache/adaptive",
      "reason": "BLIS reloads whenever its host-memory tier holds the prefix; it has no decision between copying and recomputing to compare. The scenario that exercises the tier (tiers-offload) is a check of the tiers, not of this rule."
    },
    {
      "approach": "workload/closed-loop-sessions",
      "reason": "BLIS replays traces and generates open-loop streams; it has no counterpart to the closed-loop sessions (users who wait, think and return) that the site generates, so the scenarios feed both simulators a trace instead."
    },
    {
      "approach": "workload/trace-replay",
      "reason": "It is how both simulators are given the same requests, not a mechanism BLIS models: every scenario uses it, and the conformance machinery fails when the two row sets differ, but there is nothing in BLIS to compare it with."
    }
  ]
